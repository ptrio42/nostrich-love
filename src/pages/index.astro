---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { ResumeBanner } from '../components/navigation/ResumeBanner';
import { siteConfig } from '../config/site';
import { COMPARISON_PAGES } from '../config/comparison-pages';
import { getCollection } from 'astro:content';
import { SKILL_LEVELS } from '../data/learning-paths';
import { DEFAULT_LOCALE, guidePath, guidesIndexPath } from '../i18n/paths';
import { getTranslations } from '../i18n';

const translations = getTranslations(DEFAULT_LOCALE) as typeof import('../i18n/locales/en.json');

// The title template (src/config/site.ts) already appends "| Nostrich.love",
// so the brand must NOT be repeated here — it was, producing
// "Nostrich.love - … | Nostrich.love". Lead with the entity instead: this page
// takes most of the site's inbound links and previously said "Nostr" nowhere
// in its title, description or H1, so none of that authority carried a topic.
// The frame is the course, not the five-minute signup. /guides has described
// itself as "Learn Nostr Step by Step — progressive skill levels" for months
// while this page, which takes most of the inbound links, sold a quick start;
// a reader arriving here had no way to know a structured course existed one
// click away. Still leads with "Learn Nostr" for the reasons in the note above.
const title = translations.homePage.meta.title;
const description = translations.homePage.meta.description;

// Entity anchor. Every Organization reference elsewhere on the site is an
// anonymous inline `publisher` stub inside a guide's LearningResource; this is
// the one addressable node they can all be read against, and the only place
// logo/sameAs/founder live.
//
// Deliberately no SearchAction on the WebSite node: the sitelinks searchbox was
// retired, pagefind is never invoked by the build script, and dist/ has no
// search endpoint — declaring one would describe a feature that does not exist.
const ORG_ID = `${siteConfig.url}/#organization`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': ORG_ID,
    name: siteConfig.name,
    url: siteConfig.url,
    description:
      'A free, open-source beginner guide to Nostr, the decentralized social protocol.',
    email: siteConfig.author.email,
    logo: {
      '@type': 'ImageObject',
      url: `${siteConfig.url}/logo.png`,
      width: 500,
      height: 500,
    },
    founder: { '@id': `${siteConfig.url}/about/#person` },
    sameAs: [
      siteConfig.social.repo,
      `https://njump.me/${siteConfig.social.npub}`,
      'https://sandstr.app',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteConfig.url}/#website`,
    name: siteConfig.name,
    url: siteConfig.url,
    description,
    publisher: { '@id': ORG_ID },
    inLanguage: ['en', 'pl', 'es', 'de', 'zh', 'ar', 'hi'],
  },
];

const englishGuides = await getCollection('guides', (entry) => entry.slug.startsWith(`${DEFAULT_LOCALE}/`));
const firstSteps = SKILL_LEVELS.beginner.sequence.slice(0, 4)
  .map((slug) => englishGuides.find((entry) => entry.slug === `${DEFAULT_LOCALE}/${slug}`))
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));

---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Header />
  
  <ResumeBanner client:idle />

  <main id="main-content">
    <!-- Answer the opening problem before introducing the course. -->
    <section class="border-b border-gray-200 dark:border-gray-800">
      <div class="container mx-auto grid max-w-6xl gap-y-3 px-4 pb-8 pt-12 sm:px-6 lg:grid-cols-[minmax(0,1.4fr)_minmax(17rem,0.6fr)] lg:gap-x-16 lg:gap-y-0 lg:px-8 lg:pb-12 lg:pt-20">
        <div class="max-w-measure">
          <p class="font-display text-h3 font-semibold text-gray-900 dark:text-white">{translations.homePage.hero.problem}</p>
          <p class="mt-4 text-body text-gray-600 dark:text-gray-400">{translations.homePage.hero.rules}</p>
          <p class="mt-6 border-s-2 border-primary-600 py-1 ps-4 text-body text-gray-900 dark:border-primary-400 dark:text-gray-200 sm:ps-6"><strong class="font-semibold">{translations.homePage.hero.cue}</strong> {translations.homePage.hero.answer}</p>
        </div>
        <img src="/illustrations/hero-platform-cabinet.webp" alt="" width="640" height="729" loading="eager" decoding="async" class="ms-auto h-auto w-20 sm:w-28 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mx-auto lg:w-64 lg:self-center" />
        <div class="lg:col-start-1 lg:row-start-2">
          <h1 class="mt-2 max-w-measure-narrow text-balance text-display font-bold text-gray-900 dark:text-white lg:mt-9">
            {translations.homePage.hero.title}
          </h1>
          <p class="mt-6 max-w-measure text-lead text-gray-600 dark:text-gray-400">
            {translations.homePage.hero.description}
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href={guidePath('what-is-nostr', DEFAULT_LOCALE)} class="inline-flex items-center justify-center rounded-md bg-primary-600 px-6 py-3 text-body font-semibold text-white transition-colors hover:bg-primary-700">
              {translations.homePage.hero.primaryCta}
              <svg class="ms-2 h-5 w-5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
            <a href={guidesIndexPath(DEFAULT_LOCALE)} class="text-body-sm font-medium text-primary-text underline underline-offset-2 dark:text-primary-400">{translations.homePage.hero.secondaryCta}</a>
          </div>
        </div>
      </div>

      <div class="container mx-auto max-w-6xl px-4 pb-12 sm:px-6 lg:px-8 lg:pb-16">
        <div class="grid gap-8 border-t border-gray-200 pt-8 dark:border-gray-800 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:gap-16 lg:pt-10">
          <div class="flex items-center justify-between gap-4 lg:block">
            <h2 class="text-h2 font-semibold text-gray-900 dark:text-white">{translations.homePage.whatChanges.title}</h2>
            <img src="/illustrations/identity-across-apps.webp" alt="" width="560" height="515" loading="lazy" decoding="async" class="h-auto w-24 shrink-0 lg:mt-6 lg:w-48" />
          </div>
          <dl>
            {translations.homePage.whatChanges.points.map((point) => (
              <div class="grid gap-2 border-b border-gray-200 py-5 dark:border-gray-800 md:grid-cols-[minmax(0,17rem)_minmax(0,1fr)] md:gap-10 lg:grid-cols-1 lg:gap-1">
                <dt class="text-h4 font-semibold text-gray-900 dark:text-white">{point.title}</dt>
                <dd class="max-w-measure text-body-sm text-gray-600 dark:text-gray-400">{point.description}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="py-16">
      <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <h2 class="mb-8 text-h2 font-semibold text-gray-900 dark:text-white">{translations.homePage.firstGuides.title}</h2>
        <ol class="border-t border-gray-200 dark:border-gray-800">
          {firstSteps.map((guide, index) => (
            <li>
              <a
                href={guidePath(guide.slug.replace(`${DEFAULT_LOCALE}/`, ''), DEFAULT_LOCALE)}
                class="group grid grid-cols-[2.5rem_minmax(0,1fr)_auto] gap-x-3 border-b border-gray-200 py-5 transition-colors hover:bg-gray-50 dark:border-gray-800 dark:hover:bg-gray-900 sm:grid-cols-[3rem_minmax(0,1fr)_auto] sm:gap-x-6"
              >
                <span class="font-display text-h2 tabular-nums text-gray-400 dark:text-gray-500" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div class="min-w-0 md:grid md:grid-cols-[minmax(0,18rem)_minmax(0,1fr)] md:items-baseline md:gap-x-8">
                  <h3 class="text-h3 font-semibold text-gray-900 underline-offset-2 group-hover:underline dark:text-white">{guide.data.title}</h3>
                  <p class="mt-1 text-body-sm text-gray-600 dark:text-gray-400 md:mt-0">{guide.data.description}</p>
                </div>
                <span class="col-start-3 mt-1 inline-flex items-center text-primary-text dark:text-primary-400" aria-hidden="true">
                  <svg class="h-4 w-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ol>
        <a href={guidesIndexPath(DEFAULT_LOCALE)} class="mt-6 inline-block text-body-sm font-medium text-primary-text underline underline-offset-2 dark:text-primary-400">{translations.homePage.firstGuides.allGuides}</a>
      </div>
    </section>

    <!-- Coming From Another Platform -->
    <!--
      The three /nostr-vs-* pages used to have exactly three in-content inbound
      links each, all from /guides/protocol-comparison and from each other —
      neither the homepage nor the /guides hub reached them. They are the site's
      most winnable pages (comparison intent, low competition), so they get a
      real entry point here with descriptive anchor text.
    -->
    <section class="border-t border-gray-200 py-16 dark:border-gray-800">
      <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8 flex items-center justify-between gap-4">
          <div>
            <h2 class="text-h2 font-semibold text-gray-900 dark:text-white">{translations.homePage.comparisons.title}</h2>
            <p class="mt-3 max-w-measure text-lead text-gray-600 dark:text-gray-400">
              {translations.homePage.comparisons.description}
            </p>
          </div>
          <img src="/illustrations/compare-paths.webp" alt="" width="480" height="545" loading="lazy" decoding="async" class="h-auto w-20 shrink-0 sm:w-28 lg:w-32" />
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
          {COMPARISON_PAGES.map((item) => (
            <a
              href={item.href}
              class="group border-t-2 border-gray-300 pt-4 transition-colors hover:border-primary-600 dark:border-gray-700 dark:hover:border-primary-400"
            >
              <h3 class="text-h3 font-semibold text-gray-900 underline-offset-2 group-hover:underline dark:text-white">{item.label}</h3>
              <p class="mt-2 text-body-sm text-gray-600 dark:text-gray-400">{item.blurb}</p>
              <div class="mt-4 flex items-center text-body-sm font-medium text-primary-text dark:text-primary-400">
                Compare
                <svg class="ms-2 h-4 w-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>

        <!--
          The three-way deep dive is the site's strongest asset for this audience
          and had four in-content inbound links, none from here. Adjacent-topic
          demand dwarfs Nostr's own (en.wikipedia monthly views: Bluesky 46k,
          Fediverse 16k, Mastodon 15k, Nostr 6k), and protocol-level comparisons
          are the slice of it a small site can realistically win — mainstream
          publishers do not go below the app layer.
        -->
        <p class="mt-8 text-body-sm text-gray-600 dark:text-gray-400">
          <a
            href="/guides/protocol-comparison"
            class="font-medium text-primary-text dark:text-primary-400 underline underline-offset-2"
          >
            Nostr vs ActivityPub vs Bluesky: all three protocols compared
          </a>
        </p>
      </div>
    </section>

    <!-- CTA Section.
         This is the page's one flat band (VISUAL_SYSTEM.md §4: at most one).
         It was a purple gradient panel with white text on it; the band plus the
         primary button does the same job of marking the end of the page. -->
    <section class="border-t border-gray-200 bg-gray-50 py-16 dark:border-gray-800 dark:bg-gray-900">
      <div class="container mx-auto grid max-w-6xl gap-8 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:px-8">
        <div>
          <h2 class="mb-4 text-h2 font-semibold text-gray-900 dark:text-white">{translations.homePage.closing.title}</h2>
          <p class="max-w-measure text-lead text-gray-600 dark:text-gray-400">
            {translations.homePage.closing.description}
          </p>
        </div>
        <a
          href={guidesIndexPath(DEFAULT_LOCALE)}
          class="inline-flex items-center justify-center rounded-md bg-primary-600 px-8 py-4 text-body font-semibold text-white transition-colors hover:bg-primary-700 lg:justify-self-end"
        >
          {translations.homePage.closing.cta}
          <svg class="ms-2 h-5 w-5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>

        <!--
          /resources had zero in-content inbound links and /glossary exactly one,
          from 404.html — both existed only in the global nav, which passes no
          topical signal. Descriptive anchor text, from the page with the most
          authority to spend.
        -->
        <p class="text-body-sm text-gray-500 dark:text-gray-400 lg:col-span-2">
          Already know Nostr? <a href="/tools" class="font-medium text-primary-text dark:text-primary-400 underline underline-offset-2">Jump to Tools</a> •
          Browse <a href="/resources" class="font-medium text-primary-text dark:text-primary-400 underline underline-offset-2">Nostr resources</a> •
          Look up a term in the <a href="/glossary" class="font-medium text-primary-text dark:text-primary-400 underline underline-offset-2">Nostr glossary</a> •
          Open source on <a href="https://github.com/ptrio42/nostrich-love" target="_blank" rel="noopener noreferrer" class="font-medium text-primary-text dark:text-primary-400 underline underline-offset-2">GitHub</a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
