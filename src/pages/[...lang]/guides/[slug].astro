---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import FAQAccordion from '../../../components/ui/FAQAccordion.astro';
import { RelatedQuestions } from '../../../components/ui/RelatedQuestions';
import { CTA } from '../../../components/ui/CTA';
import { ValueCard } from '../../../components/ValueCard';
import { Note } from '../../../components/ui/Note';
import { NIP } from '../../../components/ui/NIP';
import { ZapSimulator } from '../../../components/ui/ZapSimulator';
import { ScreenshotGallery } from '../../../components/ui/ScreenshotGallery';
import { RelayWorldMap } from '../../../components/ui/RelayWorldMap';
import { Callout } from '../../../components/ui/Callout';
import { CTAButton } from '../../../components/CTAButton';
import { HoverCard } from '../../../components/HoverCard';
import { ProtocolComparison } from '../../../components/ProtocolComparison';
import { ClientComparisonTable } from '../../../components/interactive/ClientComparisonTable';
import { SecurityQuiz } from '../../../components/interactive/SecurityQuiz';
import { RelayExplorer } from '../../../components/interactive/RelayExplorer';
import { TroubleshootingWizard } from '../../../components/interactive/TroubleshootingWizard';
import { AlertBanner } from '../../../components/AlertBanner';
import { BackupChecklist } from '../../../components/BackupChecklist';
import { ChecklistItem } from '../../../components/ChecklistItem';
import { ClientRecommender } from '../../../components/ClientRecommender';
import { ConfettiAnimation } from '../../../components/ConfettiAnimation';
import { KeyGenerator } from '../../../components/KeyGenerator';
import { KeyVisualizer } from '../../../components/KeyVisualizer';
import { NostrSimulator } from '../../../components/NostrSimulator';
import { ProgressBar } from '../../../components/ProgressBar';
import { ProgressIndicator } from '../../../components/ui/ProgressIndicator';
import { RelayVisualizer } from '../../../components/ui/RelayVisualizer';
import { NIP05Checker } from '../../../components/interactive/NIP05Checker';
import { PostFlowSimulator } from '../../../components/ui/PostFlowSimulator';
import { InteractiveChecklist, ChecklistProgress } from '../../../components/InteractiveChecklist';
import { H2, H3 } from '../../../components/ReadingTimeHeading';
import GuideTable from '../../../components/guides/GuideTable.astro';
// Diagram family replacing the box-drawing ASCII art. No client directive
// anywhere they are used — they render to static HTML.
import {
  DiagramCompare,
  DiagramLayers,
  DiagramNodes,
  DiagramSplit,
  MockPost,
  MockProfile,
} from '../../../components/diagrams/Diagrams';
import { MinimalProgressBar, GuidePositionIndicator } from '../../../components/progress/MinimalProgress';
import { ProgressTracker } from '../../../components/progress/ProgressTracker';
import { GuideReadAction } from '../../../components/progress/GuideReadAction';
import { GuideNavigation } from '../../../components/navigation/GuideNavigation';
import { TableOfContents, type TocHeading } from '../../../components/guides/TableOfContents';
import { ContinueLearning } from '../../../components/navigation/ContinueLearning';
import { GuideCompletionIndicator } from '../../../components/navigation/GuideCompletionIndicator';
import { EnhancedGuideCompletionIndicator } from '../../../components/navigation/EnhancedGuideCompletionIndicator';
import { PrerequisiteWarning } from '../../../components/navigation/PrerequisiteWarning';
import { BadgeEarnedModalListener } from '../../../components/gamification/BadgeEarnedModalListener';
import type { Badge } from '../../../components/gamification/types';
import { LEARNING_PATHS, getPreviousGuideInPath, getNextGuideInPath, getGuidePositionInPath, getPathLength, getAllGuidesOrdered, getGuideLevel } from '../../../data/learning-paths';
import type { MarkdownHeading } from 'astro';
import { locales, getLocaleConfig, type Locale } from '../../../config/locales';
import { langParam, DEFAULT_LOCALE, guidesIndexPath } from '../../../i18n/paths';
import { breadcrumbList } from '../../../lib/breadcrumbs';
import { faqPageSchema } from '../../../lib/faq-schema';
import { t } from '../../../i18n';

// Reading order for prev/next and the "guide N of M" indicator.
//
// This was a hand-maintained literal that had drifted out of agreement with the
// curriculum: it opened with `protocol-comparison`, so the first guide of the
// course (`what-is-nostr`) offered "Previous → Nostr vs ActivityPub vs Bluesky"
// — the hardest guide on the site — to a reader on their first page. Three
// orderings disagreed at once (this list, SKILL_LEVELS.sequence, and the
// `category` frontmatter field).
//
// SKILL_LEVELS is now the single spine. Derive from it rather than restating it,
// so adding a guide to a level cannot leave navigation behind.
const GUIDE_ORDER = getAllGuidesOrdered();

type GuideEntry = CollectionEntry<'guides'>;
type StaticPath = {
  params: { lang: string | undefined; slug: string };
  props: { guide: GuideEntry; locale: Locale };
};

export async function getStaticPaths(): Promise<StaticPath[]> {
  const allGuides = await getCollection('guides');
  const paths: StaticPath[] = [];

  for (const locale of locales) {
    const localeGuides = allGuides.filter(guide => guide.slug.startsWith(`${locale}/`));

    for (const guide of localeGuides) {
      const slug = guide.slug.replace(`${locale}/`, '');

      paths.push({
        // English gets `undefined` so the rest param emits /guides/<slug>
        params: { lang: langParam(locale), slug: slug },
        props: { guide, locale } as StaticPath['props'],
      });
    }
  }

  return paths;
}

type PageProps = { guide: GuideEntry; locale: Locale };
const { guide, locale } = Astro.props as PageProps;
// seoTitle (frontmatter, optional) is the query-matched <title>/og:title; the
// fallback keeps the legacy suffix for guides that have not opted in. The H1
// below always renders guide.data.title — reader-facing voice is unchanged.
//
// The suffix is English, so it is only ever appended on the English route.
// zh/ar/hi carry no seoTitle yet, and appending "- Nostr Beginner Guide" to a
// Chinese or Arabic title spent ~24 of the ~60 SERP characters on a string the
// reader cannot parse. Non-English guides fall back to the bare title instead.
const title =
  guide.data.seoTitle ??
  (locale === DEFAULT_LOCALE
    ? `${guide.data.title} - Nostr Beginner Guide`
    : guide.data.title);
const description = guide.data.description ?? 'Learn how to use Nostr with our beginner-friendly guides.';
const { Content, headings } = await guide.render();

// Table of contents. Astro extracts these from the markdown headings and
// rehype-slug has already put the same ids on the rendered elements, in all
// seven locales (Arabic, Chinese and Hindi included — the slugs are non-ASCII
// but they are real ids, so getElementById finds them).
//
// The parenthetical reading time some headings carry ("Understanding Keys
// (2 minutes)") is dropped: it belongs next to the heading, not in a 15rem
// column. The pattern is any trailing parenthesis containing a digit, which
// holds for "(10 minut)" and "(12 دقيقة)" too. Chinese headings use full-width
// parentheses ("（3 分钟）"), so both pairs are matched.
const HEADING_TIME_SUFFIX = /\s*[(（][^()（）]*\d[^()（）]*[)）]\s*$/;
const tocHeadings: TocHeading[] = (headings as MarkdownHeading[])
  .filter(h => (h.depth === 2 || h.depth === 3) && Boolean(h.slug) && h.text.trim().length > 0)
  .map(h => ({ depth: h.depth, slug: h.slug, text: h.text.replace(HEADING_TIME_SUFFIX, '').trim() }));

// Guides run from 4 headings to 45. A contents list is only worth its space
// when there is something to choose between: the FAQ guide is a single
// <FAQAccordion> under one heading, and a one-entry list there is furniture.
const topLevelHeadings = tocHeadings.filter(h => h.depth === 2).length;
const showToc = topLevelHeadings >= 2 && tocHeadings.length >= 3;
// Get user's active path from localStorage (default to 'general' if not set)
// This runs on server, so we'll pass the path ID to client components
const guideSlug = guide.slug.replace(`${locale}/`, '');

// The level badge reads from SKILL_LEVELS, not from the `category` frontmatter
// field. Seven of sixteen guides disagreed between the two: `multi-client` sat
// under Intermediate on the hub while its own page announced "advanced", and
// `faq`/`troubleshooting` claimed "reference", which is not a level at all.
// `category` is still in the schema for non-level uses; it is no longer rendered
// as if it were the course level. Translated per locale via skillLevels.*.label.
const guideLevel = getGuideLevel(guideSlug);
const levelLabel = guideLevel ? t(`skillLevels.${guideLevel}.label`, locale) : undefined;

// Where the reader is in the course. The counter was written, computed and then
// commented out (audit #52, #63): the settings page still promises a
// "Guide X of Y" indicator that no page rendered. It is a pure function of the
// slug, so it needs no island and no stored progress — and it counts within the
// level, which is the unit the hub, the level bars and the end-of-guide banner
// all use.
const levelPosition = guideLevel ? getGuidePositionInPath(guideSlug, guideLevel) : -1;
const levelTotal = guideLevel ? getPathLength(guideLevel) : 0;
const levelChipLabel =
  levelLabel && levelPosition > 0
    ? t('guidePage.levelPosition', locale)
        .replace('{level}', levelLabel)
        .replace('{current}', String(levelPosition))
        .replace('{total}', String(levelTotal))
    : levelLabel;

// Calculate position for both global order and path-based
const currentGuideNumGlobal = GUIDE_ORDER.indexOf(guideSlug) + 1;
const totalGuidesGlobal = GUIDE_ORDER.length;

// Path-based calculations will be done client-side
// For server-side rendering, we'll use a placeholder that client JS will update
const estimatedTimeMinutes = parseInt(guide.data.estimatedTime?.match(/\d+/)?.[0] || '10');

// Check if guide has a quiz by looking for Quiz component imports in the raw body
const hasQuiz = guide.body?.includes('Quiz') || false;

// End-of-guide block (#101b): edit link + follow CTA.
// The edit URL targets THIS page's locale file — every locale dir carries the
// same 16 .mdx filenames, so the pair is always valid. ptrio42 URLs stay safe
// after the planned transfer to ptrio42 (GitHub redirects).
const editUrl = `https://github.com/ptrio42/nostrich-love/edit/main/src/content/guides/${locale}/${guideSlug}.mdx`;
// _@nostrich.love — nip19.npubEncode of the pubkey in public/.well-known/nostr.json
const OFFICIAL_NPUB = 'npub1p6t6gjhy3q4rfmcxuff7hu3xh5u09cvzem98d48arfzsrzd9kxws3cpeyl';
const followUrl = `https://njump.me/${OFFICIAL_NPUB}`;

// Machine-readable dates, when the frontmatter actually carries them.
// `updated` is the older spelling of `lastUpdated`; read both so no guide
// silently loses its date. Guides without a real date emit none at all —
// see the schema comment in src/content/config.ts.
// Frontmatter dates arrive as Date (YAML) — render the calendar day, not an
// instant, so a UTC-midnight value cannot drift a day in either direction.
const toISODate = (value?: Date) => value?.toISOString().slice(0, 10);
const publishedDate = toISODate(guide.data.published);
const modifiedDate = toISODate(guide.data.lastUpdated ?? guide.data.updated);

// Structured data: this is an educational article, free to read, in this locale
const guideUrl = new URL(Astro.url.pathname, 'https://nostrich.love').toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: guide.data.title,
  description,
  url: guideUrl,
  mainEntityOfPage: guideUrl,
  ...(publishedDate ? { datePublished: publishedDate } : {}),
  ...(modifiedDate ? { dateModified: modifiedDate } : {}),
  inLanguage: getLocaleConfig(locale as Locale).htmlLang,
  learningResourceType: 'Guide',
  educationalLevel: 'Beginner',
  isAccessibleForFree: true,
  timeRequired: `PT${estimatedTimeMinutes}M`,
  author: {
    '@type': 'Person',
    name: 'Piotr Czarnoleski',
    url: 'https://github.com/ptrio42',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Nostrich.love',
    url: 'https://nostrich.love',
  },
  ...(guide.data.tags ? { keywords: guide.data.tags.join(', ') } : {}),
};

// Home > Guides > this guide, in this locale. The hub label is the guides
// index's own localized H1, so the trail reads in the reader's language rather
// than a hardcoded English "Guides".
// Locale passed explicitly, never inferred: page frontmatter runs BEFORE
// Layout.astro calls setServerLocale, so a bare t() here would resolve against
// whichever page the build rendered previously.
const guidesHubLabel = t('guidesPage.hero.title', locale as Locale) || 'Guides';
const breadcrumbs = breadcrumbList([
  { name: guidesHubLabel, path: guidesIndexPath(locale as Locale) },
  { name: guide.data.title, path: Astro.url.pathname },
]);

// Guides authored as <FAQAccordion> blocks also describe themselves as an
// FAQPage. Today that is the FAQ guide in each of the seven locales; the check
// is on the content, not on the slug, so a future Q&A guide gets it for free.
const faqSchema = guide.body ? faqPageSchema(guide.body, guideUrl, getLocaleConfig(locale as Locale).htmlLang) : null;

const pageSchema = [jsonLd, breadcrumbs, ...(faqSchema ? [faqSchema] : [])];

// Get guide titles for all guides (used by client-side navigation)
const allGuides = await getCollection('guides');
const guidesMap = new Map(allGuides.filter(g => g.slug.startsWith(`${locale}/`)).map(g => [g.slug.replace(`${locale}/`, ''), g]));

// Build guide titles map for client-side navigation
const guideTitles: Record<string, string> = {};
for (const [slug, guideData] of guidesMap) {
  guideTitles[slug] = guideData.data.title || slug;
}

// Build guide list for completion indicator (global order for now)
const guideList = GUIDE_ORDER.map(slug => ({
  slug,
  title: guidesMap.get(slug)?.data.title || slug
}));

// Load prerequisites from guide frontmatter
const prerequisites = guide.data.prerequisites || [];
const prerequisiteData = prerequisites.map(prereqSlug => {
  const prereqGuide = guidesMap.get(prereqSlug);
  return {
    slug: prereqSlug,
    title: prereqGuide?.data.title || prereqSlug,
    // PrerequisiteWarning renders both its per-guide clock chip and its "about
    // N minutes" footer behind this field (audit #90). It was never passed, so
    // the banner asked readers to go do prerequisite work without ever saying
    // what it costs.
    estimatedTime: prereqGuide?.data.estimatedTime
  };
});

// Calculate prev/next based on global order (path-based navigation handled client-side)
// A slug missing from GUIDE_ORDER yields indexOf === -1, i.e. currentGuideNumGlobal
// === 0, which silently hides "Previous" and sends "Next" back to the first guide.
// Fail loudly at build time instead of shipping backwards navigation.
if (currentGuideNumGlobal === 0) {
  throw new Error(
    `Guide "${guideSlug}" belongs to no skill level. ` +
    `Add it to a level's \`sequence\` in src/data/learning-paths.ts — that list is ` +
    `the course spine and now drives prev/next, the position indicator and the level badge.`
  );
}

const prevGuideSlug = currentGuideNumGlobal > 1 ? GUIDE_ORDER[currentGuideNumGlobal - 2] : null;
const nextGuideSlug = currentGuideNumGlobal < totalGuidesGlobal ? GUIDE_ORDER[currentGuideNumGlobal] : null;

const prevGuide = prevGuideSlug ? {
  slug: prevGuideSlug,
  title: guidesMap.get(prevGuideSlug)?.data.title || prevGuideSlug,
  description: guidesMap.get(prevGuideSlug)?.data.description
} : undefined;

const nextGuide = nextGuideSlug ? {
  slug: nextGuideSlug,
  title: guidesMap.get(nextGuideSlug)?.data.title || nextGuideSlug,
  description: guidesMap.get(nextGuideSlug)?.data.description
} : undefined;

// Components to make available in MDX
// Note: interactive React components in MDX hydrate with client:idle —
// they sit in prose below the fold. Use client:idle only for components that
// may server-render nothing, or whose mount has a side effect.
const components = {
  DiagramCompare,
  DiagramLayers,
  DiagramNodes,
  DiagramSplit,
  MockPost,
  MockProfile,
  FAQAccordion,
  RelatedQuestions,
  CTA,
  ValueCard,
  Note,
  NIP,
  ZapSimulator,
  ScreenshotGallery,
  RelayWorldMap,
  Callout,
  CTAButton,
  HoverCard,
  ProtocolComparison,
  ClientComparisonTable,
  SecurityQuiz,
  AlertBanner,
  BackupChecklist,
  ChecklistItem,
  ClientRecommender,
  ConfettiAnimation,
  KeyGenerator,
  KeyVisualizer,
  NostrSimulator,
  ProgressBar,
  ProgressIndicator,
  RelayVisualizer,
  NIP05Checker,
  PostFlowSimulator,
  RelayExplorer,
  TroubleshootingWizard,
  InteractiveChecklist,
  ChecklistProgress,
  H2,
  H3,
  // Lowercase key: this one overrides an HTML element, not an MDX component.
  // Every markdown pipe table in every guide renders through it and gets a
  // scroll container of its own, which is the only way a 4-column comparison
  // table stays inside the card on a phone.
  table: GuideTable,
};
---

<Layout title={title} description={description} locale={locale as Locale} type="article" author="Piotr Czarnoleski" publishedTime={publishedDate} modifiedTime={modifiedDate} jsonLd={pageSchema}>
  <Header />

  <MinimalProgressBar client:idle guideId={guideSlug} estimatedTimeMinutes={estimatedTimeMinutes} />
  <ProgressTracker client:idle guideSlug={guideSlug} guideTitle={guide.data.title} />


  <!--
    No padding on <main>. The section's own container already carries the
    page rhythm (`py-16 lg:py-24`), the same one every other page uses, and
    this template declared it a second time here — so the band between the
    header and the top of the article card measured 160px, and the band under
    the card another 160px. One declaration, in the place the rest of the site
    keeps it.
  -->
  <main id="main-content">
    <!--
      No tinted wash behind the article. The absolutely-positioned
      primary/secondary gradient that used to sit here was the one piece of
      ornament on the best-behaved template on the site; the page ground and the
      card's own border do the separating now (VISUAL_SYSTEM.md §4). With the
      overlay gone, `relative`/`overflow-hidden` had nothing left to contain.
    -->
    <section>
      <div class="container mx-auto px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
        <!-- The title and standfirst come before the contents in reading order. -->
        <article class={showToc
          ? 'prose prose-lg dark:prose-invert mx-auto max-w-3xl px-1 py-4 sm:px-6 lg:px-10 lg:py-8 xl:max-w-none xl:grid xl:grid-cols-[48rem_15rem] xl:justify-center xl:items-start xl:gap-x-10'
          : 'prose prose-lg dark:prose-invert mx-auto max-w-3xl px-1 py-4 sm:px-6 lg:px-10 lg:py-8'}>
          <div class={showToc ? 'not-prose mb-6 xl:col-start-1 xl:row-start-1' : 'not-prose mb-6'}>
            <!-- <p class="text-sm uppercase tracking-wide text-primary-600 dark:text-primary-400 font-semibold">Guide</p> -->
            <!-- <GuidePositionIndicator client:idle currentGuide={currentGuideNumGlobal} totalGuides={totalGuidesGlobal} /> -->
            <!--
              The two lines above are the whole of what an empty flex row used
              to wrap. Because that row was a real element it, not the H1, was
              `.prose > *:first-child`, so every guide opened with 2.5rem of
              margin above its title that nobody asked for.
            -->

            <!-- <EnhancedGuideCompletionIndicator -->
            <!--   client:load  -->
            <!--   guides={guideList}  -->
            <!--   currentGuideSlug={guideSlug} -->
            <!--   currentGuidePrerequisites={prerequisites} -->
            <!--   className="mb-6"  -->
            <!-- />  -->
            <!--
              Sizes here name the step the `.prose` rules in globals.css already
              render (h1 = 2.25rem/700, standfirst = the body step). They are
              written out so the intent is legible next to the rest of the pass;
              they do not fight the stylesheet.
            -->
            {levelChipLabel && (
              <p class="not-prose mb-3 text-micro font-semibold uppercase text-gray-500 dark:text-gray-400">{levelChipLabel}</p>
            )}
            <h1 class="text-h1 font-bold text-gray-900 dark:text-white">{guide.data.title}</h1>

            {guide.data.description && (
              <p class="mt-3 text-body text-gray-600 dark:text-gray-300">{guide.data.description}</p>
            )}

            <!--
              Metadata, not controls. Two of these three sat in pill grounds —
              one gray, one a primary/10 tint — which made caption text look
              clickable and spent the accent colour on a label nobody can press.
              Purple marks what you can act on (VISUAL_SYSTEM.md §4).
            -->
            <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-caption text-gray-500 dark:text-gray-400">
              {guide.data.estimatedTime && (
                <span class="inline-flex items-center gap-1.5">
                  <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {guide.data.estimatedTime}
                </span>
              )}

              {modifiedDate && (
                <span>
                  {t('guidePage.lastUpdated', locale)} <time datetime={modifiedDate}>{modifiedDate}</time>
                </span>
              )}
            </div>
          </div>

          {showToc && (
            <TableOfContents
              client:idle
              headings={tocHeadings}
              className="not-prose mb-6 xl:col-start-2 xl:row-start-1 xl:row-span-2 xl:mb-0 xl:sticky xl:top-24"
            />
          )}

          <div class={showToc ? 'xl:col-start-1 xl:row-start-2' : undefined}>

            {prerequisiteData.length > 0 && (
              <PrerequisiteWarning 
                client:idle 
                currentGuideId={guideSlug}
                currentGuideTitle={guide.data.title}
                prerequisites={prerequisiteData}
                lang={locale}
                className="mb-8"
                dismissible={true}
              />
            )}

            <Content components={components} />

            <GuideReadAction client:idle guideSlug={guideSlug} />
            
            <!--
              No client directive on purpose. GuideNavigation is a pure
              function of (currentSlug, guideTitles, locale), all known here at
              build time, so Astro renders it to static HTML and it ships zero
              JavaScript. It was `client:idle` with the slug read from
              window.location inside a useEffect, which meant every guide page
              served a pulsing skeleton with no prev/next anchors in it at all.
            -->
            <GuideNavigation
              currentSlug={guideSlug}
              guideTitles={guideTitles}
              locale={locale}
            />

            <!-- End-of-guide: improve-this-page + follow CTA (#101b). Static, no island. -->
            <div class="not-prose mt-12 pt-8 border-t border-gray-200 dark:border-gray-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
              <div class="min-w-0">
                <a
                  href={editUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-body-sm font-medium text-gray-700 dark:text-gray-300 hover:text-primary-text dark:hover:text-primary-400 transition-colors"
                >
                  <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                  </svg>
                  {t('guideFooter.improvePage', locale)}
                </a>
                <!--
                  A <span class="block">, not a <p>: the `.prose p` rule in
                  globals.css is a plain descendant selector, so it out-weighs a
                  utility class and `not-prose` on the wrapper does not stop it.
                  As a paragraph this hint rendered at the 17px body step with
                  1.25rem of margin, which is not what a hint is.
                -->
                <span class="mt-1 block text-caption text-gray-500 dark:text-gray-400">{t('guideFooter.improveHint', locale)}</span>
              </div>
              <a
                href={followUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 self-start sm:self-auto shrink-0 px-4 py-2 rounded-md bg-primary-600 hover:bg-primary-700 text-white text-body-sm font-medium transition-colors"
              >
                <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M13 10V3L4 14h7v7l9-11h-9z" />
                </svg>
                {t('officialAccount.followUs', locale)}
              </a>
            </div>
          </div>
        </article>
      </div>
    </section>
  </main>

  <ContinueLearning client:idle nextGuide={nextGuide} guideTitles={guideTitles} threshold={0.8} hasQuiz={hasQuiz} locale={locale} />

  <!-- Badge Earned Modal - Listens for badge-earned events -->
  <BadgeEarnedModalListener client:only="react" />

  <Footer />
</Layout>
