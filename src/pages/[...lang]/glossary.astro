---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { GLOSSARY_LOCALES, TERM_GUIDES, type GlossaryLocale, type TermId } from '../../data/glossary';
import type { GlossaryData, GlossaryMeta } from '../../data/glossary';
import glossaryEn, { meta as metaEn } from '../../data/glossary/en';
import glossaryPl, { meta as metaPl } from '../../data/glossary/pl';
import glossaryEs, { meta as metaEs } from '../../data/glossary/es';
import glossaryDe, { meta as metaDe } from '../../data/glossary/de';
import { getLocaleConfig } from '../../config/locales';
import { langParam, guidePath } from '../../i18n/paths';
import { t } from '../../i18n';
import { breadcrumbList } from '../../lib/breadcrumbs';

// One page per shipped glossary locale. English gets `undefined` so the rest
// param emits the un-prefixed /glossary (same pattern as the guides).
// hreflang for these pages comes from localizedLocales() in src/i18n/paths.ts —
// extend GLOSSARY_LOCALES there and add a data file to ship a new locale.
export function getStaticPaths() {
  return GLOSSARY_LOCALES.map((locale) => ({
    params: { lang: langParam(locale) },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: GlossaryLocale };

const data: Record<GlossaryLocale, { terms: GlossaryData; meta: GlossaryMeta }> = {
  en: { terms: glossaryEn, meta: metaEn },
  pl: { terms: glossaryPl, meta: metaPl },
  es: { terms: glossaryEs, meta: metaEs },
  de: { terms: glossaryDe, meta: metaDe },
};

const { terms, meta } = data[locale];
const htmlLang = getLocaleConfig(locale).htmlLang;

// Locale-correct alphabetization (bare localeCompare would sort by the
// build machine's default collation).
// Entries, not values: the id is what TERM_GUIDES is keyed on, and it is the
// only locale-independent handle on a term.
const glossaryTerms = Object.entries(terms)
  .map(([id, entry]) => ({
    ...entry,
    guideSlug: TERM_GUIDES[id as TermId],
  }))
  .sort((a, b) => a.term.localeCompare(b.term, htmlLang));

const pageUrl = new URL(Astro.url.pathname, 'https://nostrich.love').toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: t('glossary.title', locale),
  description: meta.description,
  url: pageUrl,
  inLanguage: htmlLang,
  hasDefinedTerm: glossaryTerms.map((item) => ({
    '@type': 'DefinedTerm',
    name: item.term,
    description: item.definition,
    inDefinedTermSet: pageUrl,
  })),
};

const breadcrumbs = breadcrumbList([
  { name: t('glossary.title', locale), path: Astro.url.pathname },
]);
---

<Layout title={meta.seoTitle} description={meta.description} locale={locale} jsonLd={[jsonLd, breadcrumbs]}>
  <Header />

  <main id="main-content">
    <section class="border-b border-gray-200 dark:border-gray-800">
      <div class="container mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
        <div class="max-w-measure">
          <h1 class="text-display font-bold text-gray-900 dark:text-white">
            {t('glossary.title', locale)}
          </h1>
          <p class="mt-5 text-lead text-gray-600 dark:text-gray-400">
            {t('glossary.subtitle', locale)}
          </p>

          <div class="mt-8 max-w-xl">
            <input
              type="text"
              id="glossary-search"
              aria-label={t('glossary.searchAriaLabel', locale)}
              placeholder={t('glossary.searchPlaceholder', locale)}
              class="w-full rounded-md border border-gray-200 bg-white px-4 py-3 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-600 dark:border-gray-700 dark:bg-gray-900 dark:text-white"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-gray-200 bg-gray-50 py-10 dark:border-gray-800 dark:bg-gray-900">
      <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl">
          <ul class="border-t border-gray-200 dark:border-gray-800" id="glossary-grid">
            {glossaryTerms.map((item) => (
              <li class="glossary-item border-b border-gray-200 py-5 dark:border-gray-800" data-term={item.term.toLowerCase()} data-definition={item.definition.toLowerCase()}>
                <h2 class="text-h3 font-semibold text-gray-900 dark:text-white">{item.term}</h2>
                <p class="mt-1 text-body-sm text-gray-600 dark:text-gray-400">{item.definition}</p>
                {item.guideSlug && (
                  <a
                    href={guidePath(item.guideSlug, locale)}
                    class="mt-2 inline-flex items-center gap-1 text-body-sm font-medium text-primary-text underline-offset-2 hover:underline dark:text-primary-400"
                  >
                    {t('glossary.readGuide', locale).replace('{term}', item.term)}
                    <span aria-hidden="true" class="rtl:rotate-180">→</span>
                  </a>
                )}
              </li>
            ))}
          </ul>

          <div id="no-results" class="hidden text-center py-12">
            <p class="text-gray-500 dark:text-gray-400">{t('glossary.noResults', locale)}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-12">
      <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl">
          <h2 class="mb-6 text-h2 font-semibold text-gray-900 dark:text-white">{t('glossary.quickReference.title', locale)}</h2>

          <div class="grid gap-x-8 gap-y-6 md:grid-cols-2">
            <div class="border-t-2 border-gray-300 pt-4 dark:border-gray-700">
              <h3 class="mb-1 font-semibold text-gray-900 dark:text-white">npub</h3>
              <p class="text-body-sm text-gray-600 dark:text-gray-400">{t('glossary.quickReference.npub', locale)}</p>
            </div>
            <div class="border-t-2 border-gray-300 pt-4 dark:border-gray-700">
              <h3 class="mb-1 font-semibold text-gray-900 dark:text-white">nsec</h3>
              <p class="text-body-sm text-gray-600 dark:text-gray-400">{t('glossary.quickReference.nsec', locale)}</p>
            </div>
            <div class="border-t-2 border-gray-300 pt-4 dark:border-gray-700">
              <h3 class="mb-1 font-semibold text-gray-900 dark:text-white">NIP-01</h3>
              <p class="text-body-sm text-gray-600 dark:text-gray-400">{t('glossary.quickReference.nip01', locale)}</p>
            </div>
            <div class="border-t-2 border-gray-300 pt-4 dark:border-gray-700">
              <h3 class="mb-1 font-semibold text-gray-900 dark:text-white">Kind 1</h3>
              <p class="text-body-sm text-gray-600 dark:text-gray-400">{t('glossary.quickReference.kind1', locale)}</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const searchInput = document.getElementById('glossary-search') as HTMLInputElement;
  const glossaryItems = document.querySelectorAll('.glossary-item');
  const noResults = document.getElementById('no-results');

  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase();
    let visibleCount = 0;

    glossaryItems.forEach((item) => {
      const term = item.getAttribute('data-term') || '';
      const definition = item.getAttribute('data-definition') || '';
      const shouldShow = term.includes(query) || definition.includes(query);

      (item as HTMLElement).style.display = shouldShow ? 'block' : 'none';
      if (shouldShow) visibleCount++;
    });

    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount > 0);
    }
  });
</script>
