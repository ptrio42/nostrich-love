---
/**
 * Bridge page: /nostr-vs-twitter/ — the largest, least technical audience:
 * people leaving Twitter/X.
 *
 * Standalone English page, NOT a content-collection guide (the collection
 * ratchets would force 7 locales + GUIDE_ORDER + learning-path slots).
 * The 3-way deep dive lives at /guides/protocol-comparison.
 *
 * Facts come from src/content/guides/en/protocol-comparison.mdx (fact-checked
 * February 2026). Unverified claims (user counts, crossposter links) are
 * deliberately OMITTED — network size is stated qualitatively only.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import { siteConfig } from '../config/site';
import { getAccountCount } from '../data/follow-pack';

const accountCount = getAccountCount();

const title = 'Twitter/X vs Nostr (2026): Gains and Losses';
const description =
  'No ads, no algorithm, no account that can be suspended, plus what Nostr costs you in reach and polish. An honest comparison, with a 5-minute start.';

const pageUrl = new URL(Astro.url.pathname, siteConfig.url).toString();

type Row = { dimension: string; nostr: string; twitter: string };
const rows: Row[] = [
  {
    dimension: 'Who owns your account',
    nostr: 'You. It is a cryptographic key only you hold.',
    twitter: 'The platform. It can suspend or delete the account at any time.',
  },
  {
    dimension: 'Can you be banned',
    nostr: 'Not from the protocol. Individual relays can refuse you; you post through others.',
    twitter: 'Yes: by platform policy, by a moderation decision, or under government pressure.',
  },
  {
    dimension: 'Feed & algorithm',
    nostr: 'Chronological by default; you choose the client and its behavior.',
    twitter: 'One engagement-optimized algorithmic feed.',
  },
  {
    dimension: 'Ads & tracking',
    nostr: 'No ads built into the protocol.',
    twitter: 'Ad-driven; your attention is the product.',
  },
  {
    dimension: 'Making money',
    nostr: 'Zaps: direct Lightning tips from readers, no platform cut.',
    twitter: 'Ad-revenue sharing and creator programs, gated by the platform.',
  },
  {
    dimension: 'Verification',
    nostr: 'NIP-05: a domain-based address anyone can set up.',
    twitter: 'A paid checkmark.',
  },
  {
    dimension: 'Network size & reach',
    nostr: 'Far smaller. Your audience probably is not here yet.',
    twitter: 'Massive. Nearly everyone you want to reach is there.',
  },
  {
    dimension: 'Effort to start',
    nostr: 'About 20 minutes to set up and publish with a guide. Keep a safe backup of your key.',
    twitter: 'Familiar sign-up, instant.',
  },
];

// FAQ answers are HTML (links allowed); the JSON-LD strips tags so the
// structured data always word-matches what is rendered on the page.
type Faq = { q: string; a: string };
const faqs: Faq[] = [
  {
    q: 'Is Nostr a real Twitter replacement?',
    a: 'For ownership, yes. For reach, not yet, and honesty requires saying both. Nostr replaces the parts of Twitter that depend on trusting a company: your account cannot be suspended, your feed is not engineered for ads, and your identity works across many apps. What it does not replace is Twitter’s audience. The network is far smaller, so if your goal is maximum reach today, Nostr alone will not deliver it.',
  },
  {
    q: 'Can I find my Twitter friends on Nostr?',
    a: 'Some of them. Use the free <a href="/twitter-bridge">Twitter Bridge tool</a>: search by Twitter handle or upload your following list, and it shows which of those people already have Nostr accounts. For everyone it does not find, a <a href="/follow-pack">curated follow pack</a> fills the gap.',
  },
  {
    q: 'Does Nostr have an algorithm or ads?',
    a: 'The protocol has neither. Nothing in it ranks posts for engagement and nothing in it sells ads, so feeds are chronological by default and what you see is decided by the client you choose. The honest flip side: no algorithm also means no virality machine working for you.',
  },
  {
    q: 'How do people make money on Nostr without ads?',
    a: 'Zaps. Readers attach small Bitcoin Lightning payments straight to posts they like, person to person, with no platform taking a cut and no monetization program to be accepted into. For most people it will not replace a salary. But the money goes from your audience to you, and nowhere else. The <a href="/guides/zaps-and-lightning">zaps guide</a> explains the setup.',
  },
  {
    q: 'Can my Nostr account be banned or deleted?',
    a: 'Nobody can delete it: your identity is a key pair that only you hold, and posts are cryptographically signed, so they cannot be forged or silently edited. What can happen: an individual relay can refuse to carry your posts, and individual users can mute you. Because your identity is not tied to any relay, you switch relays and carry on. There is no protocol-level ban to receive.',
  },
  {
    q: 'Is Nostr free? Do I need Bitcoin or a wallet?',
    a: 'Nostr is free to use: reading, posting, and creating an identity cost nothing, and no payment details are ever required. Bitcoin and Lightning wallets only enter the picture if you want to send or receive zaps, an optional layer you can add later or never.',
  },
  {
    q: 'Why does Nostr feel empty compared to Twitter?',
    a: 'Two reasons. The network is genuinely much smaller, and there is no algorithm surfacing viral content to fill your screen, so a fresh account with three follows sees almost nothing. The fix is to front-load your follow list. Import a <a href="/follow-pack">curated follow pack</a>, check the <a href="/twitter-bridge">Twitter Bridge</a> for people you already know, and the feed comes alive.',
  },
];

const plain = (html: string) => html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    url: pageUrl,
    mainEntityOfPage: pageUrl,
    inLanguage: 'en',
    datePublished: '2026-07-30',
    dateModified: '2026-07-30',
    isAccessibleForFree: true,
    author: { '@type': 'Organization', name: siteConfig.name, url: siteConfig.url },
    publisher: { '@type': 'Organization', name: siteConfig.name, url: siteConfig.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: plain(f.a) },
    })),
  },
];
---

<Layout title={title} description={description} type="article">
  <Header />

  <main id="main-content">
    <!-- Hero -->
    <section class="border-b border-gray-200 dark:border-gray-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <p class="text-micro uppercase text-gray-500 dark:text-gray-400 mb-4">
            Honest comparison · Updated July 2026
          </p>
          <h1 class="text-display font-bold text-gray-900 dark:text-white mb-6">
            Twitter/X vs
            <span class="text-primary-text dark:text-primary-400">Nostr</span>:
            what you gain and give up
          </h1>
          <p class="text-lead text-gray-600 dark:text-gray-300">
            Leaving X is easy to romanticize. Here is what actually changes, including
            the parts that are genuinely inconvenient.
          </p>
        </div>
      </div>
    </section>

    <!-- TL;DR gain / give up -->
    <section class="py-10">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
            <h2 class="text-h3 font-bold mb-3 text-gray-900 dark:text-white">What you gain</h2>
            <ul class="list-disc ps-6 text-body-sm text-gray-700 dark:text-gray-300 space-y-2">
              <li>An identity you own, which no platform can suspend</li>
              <li>No ads, no tracking-driven feed</li>
              <li>Chronological timelines, and a client that works for you</li>
              <li>Zaps: Bitcoin Lightning tips with no middleman</li>
              <li>Sign-up without email or phone number</li>
            </ul>
          </div>
          <div class="p-6 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
            <h2 class="text-h3 font-bold mb-3 text-gray-900 dark:text-white">What you give up</h2>
            <ul class="list-disc ps-6 text-body-sm text-gray-700 dark:text-gray-300 space-y-2">
              <li>Audience size, because the network is far smaller</li>
              <li>Discovery: no algorithm pushes your posts</li>
              <li>Polish, since the apps are rougher than X's</li>
              <li>Easy verification status symbols</li>
              <li>Someone else handling your account security</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Article body -->
    <section class="py-10">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">

          <h2 class="text-h2 font-bold mb-4 text-gray-900 dark:text-white">Ownership: whose account is it?</h2>
          <p class="text-body text-gray-600 dark:text-gray-300 mb-4">
            Your X account is, legally and practically, theirs: the platform can suspend it,
            delete it, or change the rules under it, and your followers vanish with it. Your
            <strong>Nostr identity is a cryptographic key pair</strong> generated on your device.
            No company issued it, so no company can take it away.
          </p>
          <p class="text-body text-gray-600 dark:text-gray-300 mb-8">
            The trade is responsibility: only you hold the key, and only you can lose it. There is
            no "forgot password" here. Lose your nsec and the identity is gone for good. Five
            minutes with the <a href="/guides/keys-and-security" class="text-primary-text dark:text-primary-400 underline underline-offset-2">keys guide</a>
            makes that risk manageable. Skipping it does not.
          </p>

          <h2 class="text-h2 font-bold mb-4 text-gray-900 dark:text-white">Algorithms &amp; reach</h2>
          <p class="text-body text-gray-600 dark:text-gray-300 mb-4">
            X shows you a single feed optimized for engagement, which is a polite way of saying
            optimized to keep you scrolling rather than to show you what your friends said. Nostr
            feeds are <strong>chronological by default</strong>, and because clients are
            interchangeable, the display logic is your choice instead of a company's.
          </p>
          <p class="text-body text-gray-600 dark:text-gray-300 mb-8">
            Be honest with yourself about the flip side: no algorithm also means <strong>no
            virality machine</strong>. Nothing is pushing your posts at strangers, so an audience
            grows slowly, through people actually reading you. If reach is how you pay rent, treat
            that as a real cost rather than a footnote.
          </p>

          <h2 class="text-h2 font-bold mb-4 text-gray-900 dark:text-white">Money without ads</h2>
          <p class="text-body text-gray-600 dark:text-gray-300 mb-8">
            X pays creators from ad revenue, on the platform's terms, if you are accepted and stay
            in good standing. Nostr's native answer is <strong>zaps</strong>: readers attach Bitcoin
            Lightning tips straight to posts, person to person, with no platform cut and no program
            to apply to. Zaps are optional, so you need no Bitcoin to read or post. When you are
            ready, the <a href="/guides/zaps-and-lightning" class="text-primary-text dark:text-primary-400 underline underline-offset-2">zaps guide</a>
            covers wallets and setup.
          </p>

          <h2 class="text-h2 font-bold mb-4 text-gray-900 dark:text-white">Bans &amp; censorship</h2>
          <p class="text-body text-gray-600 dark:text-gray-300 mb-8">
            On X, a policy change or a moderation decision can end your account, and so can
            government pressure on the company. The platform is one chokepoint. Nostr has no
            chokepoint to squeeze: posts are <strong>cryptographically signed</strong> (they cannot
            be forged or quietly edited) and stored on several independent relays. A relay can
            refuse your posts. It cannot take your identity, and the network as a whole has no ban
            button to press.
          </p>

          <h2 class="text-h2 font-bold mb-4 text-gray-900 dark:text-white">What you give up: the honest section</h2>
          <p class="text-body text-gray-600 dark:text-gray-300 mb-4">
            This page would be advertising, not comparison, without this part:
          </p>
          <ul class="list-disc ps-6 text-body text-gray-600 dark:text-gray-300 mb-8 space-y-2">
            <li><strong>A much smaller network.</strong> Most of your Twitter audience is not on Nostr, and if you need them you will feel it on day one.</li>
            <li><strong>Harder discovery.</strong> There is no global search index and no trending machine, so finding people takes deliberate effort.</li>
            <li><strong>Do-it-yourself spam control.</strong> With no central moderation team, more junk reaches you until you tune your filters and relays.</li>
            <li><strong>Rougher apps.</strong> Many Nostr clients are volunteer-built. They improve fast, but X-grade polish is not the baseline.</li>
          </ul>

          <h2 class="text-h2 font-bold mb-4 text-gray-900 dark:text-white">How to actually switch</h2>
          <ol class="list-decimal ps-6 text-body text-gray-600 dark:text-gray-300 mb-8 space-y-3">
            <li>
              <strong>Set up and publish in about 20 minutes.</strong> Follow the
              <a href="/guides/quickstart" class="text-primary-text dark:text-primary-400 underline underline-offset-2">quickstart</a>:
              generate keys, pick a client, post once.
            </li>
            <li>
              <strong>Back up your nsec properly.</strong> Offline, before anything else. The
              <a href="/guides/keys-and-security" class="text-primary-text dark:text-primary-400 underline underline-offset-2">keys guide</a> shows how.
            </li>
            <li>
              <strong>Find your Twitter people.</strong> The
              <a href="/twitter-bridge" class="text-primary-text dark:text-primary-400 underline underline-offset-2">Twitter Bridge</a>
              checks which accounts you follow are already on Nostr.
            </li>
            <li>
              <strong>Fill the rest of your feed.</strong> Import a
              <a href="/follow-pack" class="text-primary-text dark:text-primary-400 underline underline-offset-2">curated follow pack</a>.
              An empty feed is the #1 reason people bounce.
            </li>
            <li>
              <strong>Tell your Twitter audience where you went.</strong> Pin a post with your Nostr
              address, and give the new place a real month before judging it.
            </li>
          </ol>

          <h2 class="text-h2 font-bold mb-4 text-gray-900 dark:text-white">Side by side</h2>
        </div>

        <div class="max-w-4xl mx-auto overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-800 mb-4">
          <table class="w-full min-w-[640px] bg-white dark:bg-gray-900 text-body-sm">
            <caption class="sr-only">Nostr and Twitter/X compared across 8 dimensions</caption>
            <thead>
              <tr class="bg-gray-50 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-800">
                <th scope="col" class="p-4 text-start text-micro uppercase text-gray-500 dark:text-gray-400">Dimension</th>
                <th scope="col" class="p-4 text-start text-micro uppercase text-gray-500 dark:text-gray-400">Nostr</th>
                <th scope="col" class="p-4 text-start text-micro uppercase text-gray-500 dark:text-gray-400">Twitter/X</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
              {rows.map((row) => (
                <tr class="align-top">
                  <th scope="row" class="p-4 text-start font-semibold text-gray-900 dark:text-white whitespace-nowrap">{row.dimension}</th>
                  <td class="p-4 text-gray-600 dark:text-gray-300">{row.nostr}</td>
                  <td class="p-4 text-gray-600 dark:text-gray-300">{row.twitter}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Primary CTA -->
    <section class="py-12">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center p-8 rounded-lg border border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-900">
          <h2 class="text-h2 font-bold mb-3 text-gray-900 dark:text-white">The only way to know is to hold your own keys once</h2>
          <p class="text-body text-gray-600 dark:text-gray-300 mb-6">Keep your X account. Spend about 20 minutes seeing what the other side feels like.</p>
          <a
            href="/guides/quickstart"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 text-lead font-semibold text-white bg-primary-600 hover:bg-primary-700 rounded-md transition-colors"
          >
            Try Nostr in about 20 minutes. No email or phone number required.
          </a>
          <p class="mt-4 text-body-sm text-gray-600 dark:text-gray-400">
            Not ready for an account? <a href="https://sandstr.app" target="_blank" rel="noopener noreferrer" class="text-primary-text dark:text-primary-400 underline underline-offset-2">Try Nostr clients in your browser on Sandstr</a>. No keys, no install, nothing real.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-12 bg-gray-50 dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-h2 font-bold mb-8 text-gray-900 dark:text-white">Frequently asked questions</h2>
          {faqs.map((faq) => (
            <FAQAccordion question={faq.q} category="basics">
              <div set:html={faq.a} />
            </FAQAccordion>
          ))}
        </div>
      </div>
    </section>

    <!-- End CTAs + cross-links -->
    <section class="py-16">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
          <a href="/guides/quickstart" class="p-6 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900 transition-colors hover:border-gray-300 hover:bg-gray-50 dark:hover:border-gray-700 dark:hover:bg-gray-800">
            <h3 class="text-h3 font-bold mb-2 text-gray-900 dark:text-white">Publish your first Nostr post</h3>
            <p class="text-body-sm text-gray-600 dark:text-gray-300">Generate keys, pick a client, make your first post. No email, no phone number.</p>
          </a>
          <a href="/twitter-bridge" class="p-6 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900 transition-colors hover:border-gray-300 hover:bg-gray-50 dark:hover:border-gray-700 dark:hover:bg-gray-800">
            <h3 class="text-h3 font-bold mb-2 text-gray-900 dark:text-white">Find your Twitter follows</h3>
            <p class="text-body-sm text-gray-600 dark:text-gray-300">The Twitter Bridge shows which people you follow are already on Nostr.</p>
          </a>
          <a href="/follow-pack" class="p-6 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900 transition-colors hover:border-gray-300 hover:bg-gray-50 dark:hover:border-gray-700 dark:hover:bg-gray-800">
            <h3 class="text-h3 font-bold mb-2 text-gray-900 dark:text-white">Don't start with an empty feed</h3>
            <p class="text-body-sm text-gray-600 dark:text-gray-300">{accountCount} curated accounts, sorted by interest. Import them into any client.</p>
          </a>
        </div>

        <div class="max-w-4xl mx-auto text-center text-gray-600 dark:text-gray-300">
          <p class="mb-2">
            More head-to-head:
            <a href="/nostr-vs-bluesky/" class="text-primary-text dark:text-primary-400 underline underline-offset-2 font-medium">Nostr vs Bluesky</a>
            ·
            <a href="/nostr-vs-mastodon/" class="text-primary-text dark:text-primary-400 underline underline-offset-2 font-medium">Nostr vs Mastodon</a>
          </p>
          <p>
            Want the deep dive? Read the
            <a href="/guides/protocol-comparison" class="text-primary-text dark:text-primary-400 underline underline-offset-2 font-medium">full three-protocol technical comparison</a>.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <!-- FAQPage + Article structured data, emitted inline by this page -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>
