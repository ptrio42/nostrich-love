---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { OfficialAccountWidget } from '../components/interactive/OfficialAccountWidget';
import { siteConfig } from '../config/site';
import { getTranslations } from '../i18n';

const translations = getTranslations('en');

const title = 'About';
const description = 'Who builds nostrich.love and why. An open-source project that helps newcomers understand and use Nostr, the decentralized social protocol.';

// The @id is referenced by the Organization node's `founder` on the homepage,
// so the two pages describe one entity graph rather than two strangers. Guides
// already name "Piotr Czarnoleski" as author in prose and in their
// LearningResource — this is the addressable node those references resolve to.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${siteConfig.url}/about/#person`,
    name: 'Piotr Czarnoleski',
    alternateName: 'ptrio42',
    url: `${siteConfig.url}/about/`,
    email: siteConfig.author.email,
    sameAs: [
      'https://github.com/ptrio42',
      `https://njump.me/${siteConfig.social.npub}`,
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': `${siteConfig.url}/about/#aboutpage`,
    url: `${siteConfig.url}/about/`,
    name: `About ${siteConfig.name}`,
    description,
    mainEntity: { '@id': `${siteConfig.url}/#organization` },
  },
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Header />
  
  <main id="main-content">
    <section class="border-b border-gray-200 dark:border-gray-800">
      <div class="container mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
        <div class="max-w-measure">
          <h1 class="text-display font-bold text-gray-900 dark:text-white">
            About This Guide
          </h1>
          <p class="mt-5 text-lead text-gray-600 dark:text-gray-400">
            A free, open-source guide to Nostr, written for people who have never heard of it.
          </p>
        </div>
      </div>
    </section>

    <!-- Mission Section -->
    <section class="py-16">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-h2 font-semibold text-gray-900 dark:text-white mb-6">Why this exists</h2>
          <div class="prose dark:prose-invert max-w-none">
            <p class="text-body text-gray-600 dark:text-gray-400 mb-4">
              {translations.aboutPage.missionIntro}
            </p>
            <p class="text-body text-gray-600 dark:text-gray-400 mb-4">
              Nostr stands for Notes and Other Stuff Transmitted by Relays. It is a small, open
              protocol for social media that no company owns and that is hard to censor. Instead
              of an account on somebody's server, you have a pair of cryptographic keys, and
              those keys are what put you in control of your identity and your data.
            </p>
            <p class="text-body text-gray-600 dark:text-gray-400">
              The guide itself is free, open source, and maintained by the community.
              No ads, no tracking, no gatekeeping.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Principles Section -->
    <section class="py-16 bg-gray-50 dark:bg-gray-900 border-y border-gray-200 dark:border-gray-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-h2 font-semibold text-gray-900 dark:text-white mb-8">Our Principles</h2>

          <div class="grid grid-cols-1 gap-7 md:grid-cols-2">
            <div class="border-t-2 border-gray-300 pt-4 dark:border-gray-700">
              <h3 class="text-h3 font-semibold text-gray-900 dark:text-white mb-2">Open Source</h3>
              <p class="text-body-sm text-gray-600 dark:text-gray-400">
                All the code sits in public on GitHub. Read it, fork it, or send a fix.
              </p>
            </div>

            <div class="border-t-2 border-gray-300 pt-4 dark:border-gray-700">
              <h3 class="text-h3 font-semibold text-gray-900 dark:text-white mb-2">Privacy First</h3>
              <p class="text-body-sm text-gray-600 dark:text-gray-400">
                No tracking, no cookies, no data collection. The analytics we do run are the
                privacy-friendly kind.
              </p>
            </div>

            <div class="border-t-2 border-gray-300 pt-4 dark:border-gray-700">
              <h3 class="text-h3 font-semibold text-gray-900 dark:text-white mb-2">Accessible</h3>
              <p class="text-body-sm text-gray-600 dark:text-gray-400">
                {translations.aboutPage.accessibility}
              </p>
            </div>

            <div class="border-t-2 border-gray-300 pt-4 dark:border-gray-700">
              <h3 class="text-h3 font-semibold text-gray-900 dark:text-white mb-2">Community Driven</h3>
              <p class="text-body-sm text-gray-600 dark:text-gray-400">
                Built from inside the Nostr community. Corrections and additions are welcome.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Tech Stack Section -->
    <section class="py-16">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-h2 font-semibold text-gray-900 dark:text-white mb-6">Built With</h2>

          <div class="prose dark:prose-invert max-w-none">
            <p class="text-body text-gray-600 dark:text-gray-400 mb-4">The site runs on open-source pieces:</p>
            <ul class="space-y-2 text-body text-gray-600 dark:text-gray-400">
              <li><strong>Astro</strong> builds the static pages</li>
              <li><strong>React</strong> handles the interactive parts</li>
              <li><strong>Tailwind CSS</strong> does the styling</li>
              <li><strong>TypeScript</strong> everywhere, so mistakes surface early</li>
              <li><strong>shadcn/ui</strong> for the interface components</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Maintainer Section -->
    <section class="py-16 border-t border-gray-200 dark:border-gray-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-h2 font-semibold text-gray-900 dark:text-white mb-6">Who Builds This</h2>
          <div class="prose dark:prose-invert max-w-none">
            <p class="text-body text-gray-600 dark:text-gray-400 mb-4">
              Nostrich.love is built and maintained by
              <strong>Piotr Czarnoleski</strong>
              (<a href="https://github.com/ptrio42" target="_blank" rel="noopener noreferrer" class="text-primary-text dark:text-primary-400 underline underline-offset-2">ptrio42</a>),
              a developer who has been building on nostr since 2023. He runs relays written in Go,
              built <a href="https://swarmstr.com" target="_blank" rel="noopener noreferrer" class="text-primary-text dark:text-primary-400 underline underline-offset-2">swarmstr.com</a>
              (a Q&amp;A client for the protocol), and contributes to nostr open source such as the
              <a href="https://github.com/fiatjaf/khatru" target="_blank" rel="noopener noreferrer" class="text-primary-text dark:text-primary-400 underline underline-offset-2">khatru</a>
              relay framework.
            </p>
            <p class="text-body text-gray-600 dark:text-gray-400 mb-4">
              This site exists because onboarding is the step he kept watching newcomers fail at,
              especially outside English. Every guide, tool and translation here is open source,
              and corrections are welcome from anyone.
            </p>
            <ul class="space-y-2 text-body text-gray-600 dark:text-gray-400">
              <li><strong>Nostr:</strong> <code>_@nostrich.love</code> (NIP-05)</li>
              <li><strong>Email:</strong> <a href="mailto:hello@nostrich.love" class="text-primary-text dark:text-primary-400 underline underline-offset-2">hello@nostrich.love</a></li>
              <li><strong>Source code:</strong> <a href="https://github.com/ptrio42/nostrich-love" target="_blank" rel="noopener noreferrer" class="text-primary-text dark:text-primary-400 underline underline-offset-2">GitHub</a> (MIT licensed)</li>
              <li><strong>Support:</strong> value for value, via <a href="/support" class="text-primary-text dark:text-primary-400 underline underline-offset-2">zaps, Lightning or on-chain</a></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Official Account Section -->
    <section class="py-16 border-t border-gray-200 dark:border-gray-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-h2 font-semibold text-gray-900 dark:text-white mb-6">Follow Us on Nostr</h2>
          <p class="text-lead text-gray-600 dark:text-gray-400 mb-8 max-w-measure">
            New guides and site news get posted to the official Nostr account.
          </p>
          <OfficialAccountWidget client:idle expanded={true} />
        </div>
      </div>
    </section>

    <!-- Contribute Section -->
    <section class="py-20 border-t border-gray-200 dark:border-gray-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-h2 font-semibold text-gray-900 dark:text-white mb-4">
          Join the Community
        </h2>
        <p class="text-lead text-gray-600 dark:text-gray-400 mb-8 max-w-measure mx-auto">
          Help make Nostr easier to walk into. Fixes, bug reports and suggestions all go through GitHub.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://github.com/ptrio42/nostrich-love"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-8 py-4 text-body font-semibold text-white bg-primary-600 hover:bg-primary-700 rounded-md transition-colors"
          >
            Contribute on GitHub
          </a>
          <a
            href="/guides"
            class="inline-flex items-center justify-center px-8 py-4 text-body font-semibold text-primary-text dark:text-primary-400 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-md transition-colors hover:border-gray-300 hover:bg-gray-50 dark:hover:border-gray-700 dark:hover:bg-gray-800"
          >
            Start Learning
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
