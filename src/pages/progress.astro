---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { getCollection } from 'astro:content';
import { getLevelLength, getAllGuidesOrdered } from '../data/learning-paths';

// Pre-hydration numbers. These used to be typed in by hand (15 overall, 0/6 for
// a seven-guide level), so the page disagreed with the course spine and a reader
// who finished everything was shown 107%. learning-paths.ts is the source.
const beginnerTotal = getLevelLength('beginner');
const intermediateTotal = getLevelLength('intermediate');
const advancedTotal = getLevelLength('advanced');

// Guide titles for the level lists and Recent Activity. The inline script used
// to carry its own hand-written table of 15 titles, which had drifted from the
// guides themselves ("What is Nostr?" where the guide is called "Nostr Explained
// Simply") and was missing `outbox-model` entirely, so that row rendered as the
// raw slug. This page is English-only, so the en/ entries are the right ones.
// Passed through a JSON script tag because a module script cannot read
// frontmatter and define:vars would forbid the imports it needs.
const englishGuides = await getCollection('guides', (entry) => entry.slug.startsWith('en/'));
const guideMetadata = Object.fromEntries(
  getAllGuidesOrdered().map((slug) => {
    const entry = englishGuides.find((g) => g.slug === `en/${slug}`);
    return [slug, { title: entry?.data.title ?? slug, description: entry?.data.description ?? '' }];
  })
);
---

<!-- noindex: this page renders the visitor's own localStorage state, so it is
       identical and near-empty for everyone who is not already using the site.
       Nobody searches for it, and it was sitting in the sitemap next to real
       content. Also excluded from the sitemap in astro.config.mjs. -->
<Layout
  title="Your Progress - Nostr Beginner Guide"
  description="Track your learning progress through Beginner, Intermediate, and Advanced skill levels."
  noindex
>
  <Header />

  <main id="main-content">
    <section class="border-b border-gray-200 dark:border-gray-800">
      <div class="container mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
        <div class="max-w-measure">
          <h1 class="text-display font-bold text-gray-900 dark:text-white">
            Your Progress
          </h1>
          <p class="mt-5 text-lead text-gray-600 dark:text-gray-400">
            Master Nostr one level at a time. Everything is open. This just tracks how far you have got.
          </p>
        </div>
      </div>
    </section>

    <!-- Course status -->
    <section class="border-y border-gray-200 bg-gray-50 py-8 dark:border-gray-800 dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 md:grid-cols-3">
          <!-- Guides Completed Card -->
          <div class="border-t-2 border-gray-300 pt-4 dark:border-gray-700">
            <div class="flex items-center gap-4">
              <svg class="h-6 w-6 shrink-0 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div>
                <p class="text-caption text-gray-500 dark:text-gray-400">Guides Completed</p>
                <p id="guides-completed-count" class="font-display text-h2 font-bold text-gray-900 dark:text-white">0</p>
              </div>
            </div>
          </div>

          <!-- Current Level Card -->
          <div class="border-t-2 border-gray-300 pt-4 dark:border-gray-700">
            <div class="flex items-center gap-4">
              <svg class="h-6 w-6 shrink-0 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z" />
                <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65" />
                <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65" />
              </svg>
              <div class="min-w-0 flex-1">
                <p class="text-caption text-gray-500 dark:text-gray-400">Current Level</p>
                <p id="current-level-name" class="font-display text-h3 font-bold text-gray-900 dark:text-white truncate">Beginner</p>
              </div>
            </div>
          </div>

          <!-- Overall Progress Card -->
          <div class="border-t-2 border-gray-300 pt-4 dark:border-gray-700">
            <div class="flex items-center gap-4">
              <svg class="h-6 w-6 shrink-0 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
              <div>
                <p class="text-caption text-gray-500 dark:text-gray-400">Overall Progress</p>
                <p id="progress-percentage" class="font-display text-h2 font-bold text-gray-900 dark:text-white">0%</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Skill Level Progression -->
    <section class="py-12">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-h2 font-semibold text-gray-900 dark:text-white mb-8">Skill Progression</h2>
          
          <div class="mb-12">
            <div id="level-container" class="space-y-12">
              <!-- Beginner Level -->
              <section class="level-section relative" data-level="beginner">
                <div class="border-t-2 border-gray-300 pt-6 dark:border-gray-700">
                  <!-- Level Header -->
                  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                    <div class="flex items-center gap-4">
                      <div>
                        <h3 class="text-h2 font-semibold text-gray-900 dark:text-white">Beginner</h3>
                        <p class="text-body-sm text-gray-600 dark:text-gray-400">Foundation of Nostr</p>
                      </div>
                    </div>
                  </div>

                  <!-- Progress Bar -->
                  <div class="mb-6">
                    <div class="flex justify-between text-body-sm mb-2">
                      <span class="text-gray-600 dark:text-gray-400">Progress</span>
                      <span class="progress-text font-semibold text-gray-900 dark:text-white">{`0/${beginnerTotal} guides`}</span>
                    </div>
                    <div class="h-3 w-full bg-gray-200 dark:bg-gray-800 rounded-full overflow-hidden">
                      <div class="progress-fill h-full bg-primary-600 rounded-full transition-all duration-500 motion-reduce:transition-none" style="width: 0%"></div>
                    </div>
                  </div>


                  <!-- Guide List -->
                  <div class="guide-list border-t border-gray-200 dark:border-gray-800">
                    <!-- Guides populated by JavaScript -->
                  </div>
                </div>
              </section>

              <!-- Intermediate Level -->
              <section class="level-section relative" data-level="intermediate">
                <div class="border-t-2 border-gray-300 pt-6 dark:border-gray-700">
                  <!-- Level Header -->
                  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                    <div class="flex items-center gap-4">
                      <div>
                        <h3 class="text-h2 font-semibold text-gray-900 dark:text-white">Intermediate</h3>
                        <p class="text-body-sm text-gray-600 dark:text-gray-400">Level up your skills</p>
                      </div>
                    </div>
                  </div>

                  <!-- Progress Bar -->
                  <div class="mb-6">
                    <div class="flex justify-between text-body-sm mb-2">
                      <span class="text-gray-600 dark:text-gray-400">Progress</span>
                      <span class="progress-text font-semibold text-gray-900 dark:text-white">{`0/${intermediateTotal} guides`}</span>
                    </div>
                    <div class="h-3 w-full bg-gray-200 dark:bg-gray-800 rounded-full overflow-hidden">
                      <div class="progress-fill h-full bg-primary-600 rounded-full transition-all duration-500 motion-reduce:transition-none" style="width: 0%"></div>
                    </div>
                  </div>


                  <!-- Guide List -->
                  <div class="guide-list border-t border-gray-200 dark:border-gray-800">
                    <!-- Guides populated by JavaScript -->
                  </div>
                </div>
              </section>

              <!-- Advanced Level -->
              <section class="level-section relative" data-level="advanced">
                <div class="border-t-2 border-gray-300 pt-6 dark:border-gray-700">
                  <!-- Level Header -->
                  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                    <div class="flex items-center gap-4">
                      <div>
                        <h3 class="text-h2 font-semibold text-gray-900 dark:text-white">Advanced</h3>
                        <p class="text-body-sm text-gray-600 dark:text-gray-400">Master the protocol</p>
                      </div>
                    </div>
                  </div>

                  <!-- Progress Bar -->
                  <div class="mb-6">
                    <div class="flex justify-between text-body-sm mb-2">
                      <span class="text-gray-600 dark:text-gray-400">Progress</span>
                      <span class="progress-text font-semibold text-gray-900 dark:text-white">{`0/${advancedTotal} guides`}</span>
                    </div>
                    <div class="h-3 w-full bg-gray-200 dark:bg-gray-800 rounded-full overflow-hidden">
                      <div class="progress-fill h-full bg-primary-600 rounded-full transition-all duration-500 motion-reduce:transition-none" style="width: 0%"></div>
                    </div>
                  </div>


                  <!-- Guide List -->
                  <div class="guide-list border-t border-gray-200 dark:border-gray-800">
                    <!-- Guides populated by JavaScript -->
                  </div>
                </div>
              </section>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Recent Activity Section -->
    <section class="py-12 border-t border-gray-200 dark:border-gray-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-h2 font-semibold text-gray-900 dark:text-white mb-6">Recent Activity</h2>

          <div id="recent-activity" class="border-t border-gray-200 dark:border-gray-800">
            <div class="border-b border-gray-200 py-5 dark:border-gray-800">
              <p class="text-body-sm text-gray-500 dark:text-gray-400">
                No activity yet. Start learning to see your progress here!
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 border-t border-gray-200 dark:border-gray-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-h2 font-semibold text-gray-900 dark:text-white mb-4">
          Keep leveling up!
        </h2>
        <p class="text-lead text-gray-600 dark:text-gray-400 mb-8 max-w-measure mx-auto">
          Every guide you finish moves you further along. Nothing is gated, so read in any order you like.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/guides"
            class="inline-flex items-center justify-center px-8 py-4 text-body font-semibold text-white bg-primary-600 hover:bg-primary-700 rounded-md transition-colors"
          >
            Continue Learning
            <svg class="ms-2 h-5 w-5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <!-- The one live entrance to /badges. It was commented out, which left
               twelve badges awarded and a celebration modal firing with no page
               a reader could ever open to see the collection. -->
          <a
            href="/badges"
            class="inline-flex items-center justify-center px-8 py-4 text-body font-semibold text-primary-text dark:text-primary-400 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-md transition-colors hover:border-gray-300 hover:bg-gray-50 dark:hover:border-gray-700 dark:hover:bg-gray-800"
          >
            View Your Badges
            <svg class="ms-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Guide titles, straight from the content collection. Read by the script below. -->
  <script
    id="guide-metadata"
    type="application/json"
    set:html={JSON.stringify(guideMetadata).replace(/</g, '\\u003c')}
    is:inline
  ></script>

  <Footer />
</Layout>

<script>
  import { loadGamificationData, getCompletedInLevel, getLevelProgress } from '../utils/gamification';
  import { SKILL_LEVELS, getLevelLength, getAllGuidesOrdered, type SkillLevel } from '../data/learning-paths';

  const STORAGE_KEY = 'nostrich-gamification-v1';

  /** Shape returned by getProgressData() — pinned so the success and the
   *  error branch agree and level keys stay indexable by SkillLevel. */
  interface ProgressSnapshot {
    completedGuides: string[];
    completedWithTimestamps: { id: string; completedAt: string }[];
    unlockedLevels: SkillLevel[];
    completedByLevel: Record<SkillLevel, string[]>;
  }
  
  // Guide titles for display, rendered into #guide-metadata from the content
  // collection in this page's frontmatter. This was a hand-written table that
  // named guides differently from /guides and had no entry for `outbox-model`.
  type GuideMeta = { title: string; description: string };

  const guideMetadata: Record<string, GuideMeta> = (() => {
    try {
      const el = document.getElementById('guide-metadata');
      return el?.textContent ? JSON.parse(el.textContent) : {};
    } catch (e) {
      console.error('Error reading guide metadata:', e);
      return {};
    }
  })();

  /** Never render a raw slug at the reader: fall back to a readable title. */
  function metaFor(guideId: string): GuideMeta {
    return (
      guideMetadata[guideId] || {
        title: guideId.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
        description: '',
      }
    );
  }

  // Format date for recent activity
  function formatDate(dateString: string): string {
    const date = new Date(dateString);
    const now = new Date();
    const diffMs = now.getTime() - date.getTime();
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);

    if (diffMins < 1) return 'Just now';
    if (diffMins < 60) return `${diffMins} minute${diffMins > 1 ? 's' : ''} ago`;
    if (diffHours < 24) return `${diffHours} hour${diffHours > 1 ? 's' : ''} ago`;
    if (diffDays < 7) return `${diffDays} day${diffDays > 1 ? 's' : ''} ago`;
    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

  // Get progress data
  function getProgressData(): ProgressSnapshot {
    try {
      const data = loadGamificationData();
      return {
        completedGuides: data.progress?.completedGuides || [],
        completedWithTimestamps: data.progress?.completedGuidesWithTimestamps || [],
        unlockedLevels: data.progress?.unlockedLevels || ['beginner'],
        completedByLevel: data.progress?.completedByLevel || {
          beginner: [],
          intermediate: [],
          advanced: []
        }
      };
    } catch (e) {
      console.error('Error reading progress data:', e);
      return {
        completedGuides: [],
        completedWithTimestamps: [],
        unlockedLevels: ['beginner'],
        completedByLevel: { beginner: [], intermediate: [], advanced: [] }
      };
    }
  }

  // Update summary cards
  function updateSummaryCards() {
    const { completedGuides, completedByLevel } = getProgressData();
    // Was hardcoded 15 against a 16-guide course, so finishing everything read 107%.
    const totalGuides = getAllGuidesOrdered().length;
    
    // Update guides completed count
    const guidesCountEl = document.getElementById('guides-completed-count');
    if (guidesCountEl) {
      guidesCountEl.textContent = completedGuides.length.toString();
    }
    
    // Update current level
    const levelOrder: SkillLevel[] = ['beginner', 'intermediate', 'advanced'];
    // Furthest level the reader has actually started, rather than unlocked.
    const currentLevel = [...levelOrder].reverse().find(
      (lvl) => (completedByLevel[lvl]?.length || 0) > 0
    ) || 'beginner';
    const levelNames: Record<string, string> = {
      beginner: 'Beginner',
      intermediate: 'Intermediate',
      advanced: 'Advanced'
    };

    const levelNameEl = document.getElementById('current-level-name');
    if (levelNameEl) levelNameEl.textContent = levelNames[currentLevel];
    
    // Update percentage
    const percentageEl = document.getElementById('progress-percentage');
    if (percentageEl) {
      const percentage = totalGuides > 0 ? Math.round((completedGuides.length / totalGuides) * 100) : 0;
      percentageEl.textContent = `${percentage}%`;
    }
  }

  // Update level sections
  function updateLevelSections() {
    const { completedByLevel } = getProgressData();
    const levels: ('beginner' | 'intermediate' | 'advanced')[] = ['beginner', 'intermediate', 'advanced'];
    
    levels.forEach((level, index) => {
      const section = document.querySelector(`[data-level="${level}"]`) as HTMLElement;
      if (!section) return;
      
      const completed = completedByLevel[level]?.length || 0;
      const total = getLevelLength(level);
      const percentage = total > 0 ? Math.round((completed / total) * 100) : 0;
      
      // Update progress bar
      const progressText = section.querySelector('.progress-text') as HTMLElement;
      const progressFill = section.querySelector('.progress-fill') as HTMLElement;
      
      if (progressText) progressText.textContent = `${completed}/${total} guides`;
      if (progressFill) progressFill.style.width = `${percentage}%`;
      
      // Update guide list
      const guideList = section.querySelector('.guide-list') as HTMLElement;
      if (guideList) {
        // English is served un-prefixed (prefixDefaultLocale: false), so
        // /en/guides/* would only 301. Inline scripts cannot import i18n/paths.
        const savedLang = localStorage.getItem('preferredLanguage');
        const locale = savedLang && ['en','pl','es','de','zh','ar','hi'].includes(savedLang) ? savedLang : 'en';
        const guidesPrefix = locale === 'en' ? '/guides' : `/${locale}/guides`;

        const guides = SKILL_LEVELS[level]?.sequence || [];
        const startIndex = levels.slice(0, index).reduce((count, priorLevel) => count + getLevelLength(priorLevel), 0);
        guideList.innerHTML = guides.map((guideId, idx) => {
          const meta = metaFor(guideId);
          const isCompleted = completedByLevel[level]?.includes(guideId);
          const position = startIndex + idx + 1;
          
          return `
            <a href="${guidesPrefix}/${guideId}"
               class="guide-item grid grid-cols-[2rem_minmax(0,1fr)_auto] items-start gap-3 border-b border-gray-200 py-4 transition-colors hover:bg-gray-50 dark:border-gray-800 dark:hover:bg-gray-800 ${isCompleted ? 'completed' : ''}"
               data-guide="${guideId}"
            >
              <div class="w-8 h-8 flex items-center justify-center flex-shrink-0">
                ${isCompleted
                  ? `<svg class="h-5 w-5 text-success-600 dark:text-success-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
                    </svg>`
                  : `<span class="font-display text-h3 text-gray-500 dark:text-gray-400">${String(position).padStart(2, '0')}</span>`
                }
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-medium ${isCompleted ? 'text-gray-600 dark:text-gray-400' : 'text-gray-900 dark:text-white'}">
                  ${meta.title}
                </p>
                <p class="text-caption text-gray-500 dark:text-gray-400 line-clamp-2">
                  ${meta.description}
                </p>
              </div>
              ${isCompleted
                ? `<span class="text-caption text-success-700 dark:text-success-400 font-medium flex-shrink-0">Completed</span>`
                : `<svg class="h-5 w-5 text-gray-400 dark:text-gray-500 flex-shrink-0 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
                  </svg>`
              }
            </a>
          `;
        }).join('');
      }
    });
  }

  // Update recent activity
  function updateRecentActivity() {
    const { completedWithTimestamps } = getProgressData();
    const container = document.getElementById('recent-activity');
    
    if (!container) return;
    
    // Get completed guides with timestamps, sorted by completion date
    const completedGuides = completedWithTimestamps
      .map((guide: any) => ({
        ...guide,
        metadata: metaFor(guide.id),
      }))
      .sort((a: any, b: any) => new Date(b.completedAt).getTime() - new Date(a.completedAt).getTime())
      .slice(0, 5); // Show last 5
    
    if (completedGuides.length === 0) {
      container.innerHTML = `
        <div class="border-b border-gray-200 py-5 dark:border-gray-800">
          <p class="text-body-sm text-gray-500 dark:text-gray-400">
            No activity yet. Start learning to see your progress here!
          </p>
        </div>
      `;
      return;
    }
    
    container.innerHTML = completedGuides.map((guide: any) => `
      <div class="flex items-center gap-4 border-b border-gray-200 py-4 dark:border-gray-800">
        <svg class="h-5 w-5 shrink-0 text-success-600 dark:text-success-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
        </svg>
        <div class="flex-1 min-w-0">
          <p class="font-semibold text-gray-900 dark:text-white truncate">
            ${guide.metadata.title}
          </p>
          <p class="text-body-sm text-gray-500 dark:text-gray-400">
            ${guide.metadata.description}
          </p>
        </div>
        <span class="text-caption text-gray-400 dark:text-gray-500 flex-shrink-0">
          ${formatDate(guide.completedAt)}
        </span>
      </div>
    `).join('');
  }

  // Initialize page
  function init() {
    updateSummaryCards();
    updateLevelSections();
    updateRecentActivity();
    
    // Listen for storage changes
    window.addEventListener('storage', (e) => {
      if (e.key === STORAGE_KEY) {
        updateSummaryCards();
        updateLevelSections();
        updateRecentActivity();
      }
    });
    
  }

  // Run initialization
  if (typeof window !== 'undefined') {
    init();
  }
</script>
