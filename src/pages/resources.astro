---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { breadcrumbList } from '../lib/breadcrumbs';

const title = 'Nostr Resources';
const description = 'A curated collection of Nostr resources: clients, relays, documentation, communities and tools, each with a line on what it is for.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: 'https://nostrich.love/resources/',
    inLanguage: 'en',
    isPartOf: { '@id': 'https://nostrich.love/#website' },
  },
  breadcrumbList([{ name: title, path: '/resources/' }]),
];

const resourceCategories = [
  {
    priority: 2,
    title: 'Official Documentation',
    description: 'Core protocol documentation and specifications',
    resources: [
      {
        title: 'Nostr Protocol',
        description: 'The official Nostr protocol website with protocol basics',
        url: 'https://nostr.com',
        type: 'website',
      },
      {
        title: 'NIPs Repository',
        description: 'Nostr Implementation Possibilities: the full protocol specification',
        url: 'https://github.com/nostr-protocol/nips',
        type: 'github',
      },
      {
        title: 'Nostr GitHub',
        description: 'Official protocol repository and resources',
        url: 'https://github.com/nostr-protocol/nostr',
        type: 'github',
      },
    ],
  },
  {
    priority: 0,
    title: 'Client Apps',
    description: 'Popular Nostr clients for different platforms',
    resources: [
      {
        title: 'Sandstr',
        description: 'Try Nostr clients in your browser first. No keys, no install, nothing real',
        url: 'https://sandstr.app',
        type: 'app',
      },
      {
        title: 'Damus',
        description: 'iOS client, one of the most popular mobile apps',
        url: 'https://damus.io',
        type: 'app',
      },
      {
        title: 'Iris',
        description: 'Web and mobile client with a clean interface',
        url: 'https://iris.to',
        type: 'app',
      },
      {
        title: 'Amethyst',
        description: 'Android client with a deep feature set',
        url: 'https://github.com/vitorpamplona/amethyst',
        type: 'app',
      },
      {
        title: 'Coracle',
        description: 'Advanced web client with relay management',
        url: 'https://coracle.social',
        type: 'app',
      },
    ],
  },
  {
    priority: 3,
    title: 'Developer Resources',
    description: 'Tools and libraries for building on Nostr',
    resources: [
      {
        title: 'nostr-tools',
        description: 'The JavaScript/TypeScript library most Nostr apps are built on',
        url: 'https://github.com/nbd-wtf/nostr-tools',
        type: 'github',
      },
      {
        title: 'Awesome Nostr',
        description: 'A long, curated list of Nostr projects and resources',
        url: 'https://github.com/aljazceru/awesome-nostr',
        type: 'github',
      },
      {
        title: 'Nostr Dev Kit',
        description: 'Tools and documentation for Nostr developers',
        url: 'https://ndk.fyi',
        type: 'website',
      },
    ],
  },
  {
    priority: 1,
    title: 'Communities',
    description: 'Places to connect with other Nostr users',
    resources: [
      {
        title: 'Stacker News',
        description: 'Bitcoin-focused community that supports Nostr login',
        url: 'https://stacker.news',
        type: 'community',
      },
      {
        title: 'Nostr Reddit',
        description: 'Reddit community for Nostr discussions',
        url: 'https://reddit.com/r/nostr',
        type: 'community',
      },
    ],
  },
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Header />
  
  <main id="main-content">
    <section>
      <div class="container mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
        <div class="max-w-measure">
          <h1 class="text-display font-bold text-gray-900 dark:text-white">
            Nostr Resources
          </h1>
          <p class="mt-5 text-lead text-gray-600 dark:text-gray-400">
            A curated collection of resources for learning about and using Nostr, from the
            official protocol docs to community-built tools.
          </p>
        </div>
      </div>
    </section>

    <section class="border-y border-gray-200 bg-gray-50 py-10 dark:border-gray-800 dark:bg-gray-900">
      <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="space-y-10">
          {[...resourceCategories].sort((a, b) => a.priority - b.priority).map((category) => (
            <section class="grid gap-5 border-t border-gray-200 pt-7 dark:border-gray-800 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-12">
              <div>
                <h2 class="text-h2 font-semibold text-gray-900 dark:text-white">{category.title}</h2>
                <p class="mt-2 text-body-sm text-gray-600 dark:text-gray-400">{category.description}</p>
              </div>
              <ul class="border-t border-gray-200 dark:border-gray-800">
                {category.resources.map((resource) => (
                  <li class="border-b border-gray-200 dark:border-gray-800"><a
                    href={resource.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group block py-4 transition-colors hover:bg-white dark:hover:bg-gray-800"
                  >
                    <div class="flex items-start justify-between">
                      <div>
                        <h3 class="text-h4 font-semibold text-gray-900 dark:text-white group-hover:text-primary-text dark:group-hover:text-primary-400 transition-colors">
                          {resource.title}
                        </h3>
                        <p class="text-body-sm text-gray-600 dark:text-gray-400 mt-1">
                          {resource.description}
                        </p>
                      </div>
                      <svg class="h-5 w-5 text-gray-400 dark:text-gray-500 group-hover:text-primary-text dark:group-hover:text-primary-400 transition-colors flex-shrink-0 ms-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </div>
                  </a></li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20">
      <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-h2 font-semibold text-gray-900 dark:text-white mb-4">
          Want to contribute?
        </h2>
        <p class="text-lead text-gray-600 dark:text-gray-400 mb-8 max-w-measure">
          This guide is open source. If something belongs on this list and is not here yet, open an issue.
        </p>
        <a
          href="https://github.com/ptrio42/nostrich-love"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-8 py-4 text-body font-semibold text-white bg-primary-600 hover:bg-primary-700 rounded-md transition-colors"
        >
          Contribute on GitHub
          <svg class="ms-2 h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
