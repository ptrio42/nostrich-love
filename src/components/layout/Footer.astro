---
import SocialShare from '../ui/SocialShare.astro';
import { siteConfig } from '../../config/site';
import { LogoText } from '../ui/LogoText';
import { locales, getLocaleConfig } from '../../config/locales';
import { localizedLocales, localePath, guidesIndexPath, splitLocale } from '../../i18n/paths';
// Locale passed explicitly to t(): Footer renders inside Layout's slot, but
// relying on that ordering for a string this visible is not worth the coupling.
import { t } from '../../i18n';

// Link labels are ids, not text: every one of these shipped as English on all
// seven locales. `label` stays literal only where the string is the same in
// every language (an acronym, a brand, a filename); everything else resolves
// through footer.links.<id>.
//
// The hrefs stayed literal after that fix, which was the worse half of the bug:
// a Polish reader saw "Słownik pojęć" pointing at /glossary, so the label
// promised a translated page and the link delivered the English one. Every
// internal href below now goes through localizedHref() — see its comment for
// which routes ship locale variants and which do not.
//
// The `resources` group that used to live here rendered nowhere — the template
// has four columns (learn, tools, community, about) and never read it.
const footerLinks = {
  learn: [
    { id: 'gettingStarted', href: '/guides/' },
    { id: 'interactiveTools', href: '/tools/' },
    { id: 'glossary', href: '/glossary/' },
    { id: 'faq', href: '/guides/faq/' },
  ],
  community: [
    { id: 'nostrProtocol', href: 'https://nostr.com', external: true },
    { id: 'github', label: 'GitHub', href: siteConfig.social.github, external: true },
    { id: 'nips', label: 'NIPs', href: 'https://github.com/nostr-protocol/nips', external: true },
    // "RSS" is a locale-invariant acronym — no i18n key, same as its siblings.
    { id: 'rss', label: 'RSS', href: '/rss.xml', external: false },
  ],
  about: [
    { id: 'aboutUs', href: '/about/' },
    { id: 'support', href: '/support/' },
    { id: 'settings', href: '/settings/' },
    { id: 'privacyPolicy', href: '/privacy/' },
    { id: 'humansTxt', label: 'humans.txt', href: '/humans.txt' },
  ],
};

const toolLinks = [
  { id: 'relayPlayground', href: '/tools/#relay-playground' },
  { id: 'keyGenerator', href: '/tools/key-generator/' },
  { id: 'followPackFinder', href: '/follow-pack/' },
];

const currentYear = new Date().getFullYear();

// Crawlable language links.
//
// The language switcher in the header is a React island whose options are
// <button onClick> and whose pre-hydration markup is a bare globe icon, so the
// static HTML contained no <a href> into any locale directory at all — zero
// un-prefixed page linked to /pl/, /es/, /de/, /zh/, /ar/ or /hi/. The locale
// hubs were reachable only via the sitemap and hreflang, which are hints rather
// than links, so 105 localized URLs carried no internal link equity.
//
// On a route that genuinely ships locale variants (guides, glossary) these
// mirror the hreflang cluster exactly — localizedLocales() is the same source
// of truth SEO.astro uses, so this can never advertise a 404. Everywhere else
// they fall back to each locale's guides hub, which is the entry point a
// non-English reader actually wants.
const currentPath = Astro.url.pathname;
const routeLocales = localizedLocales(currentPath);
const hasRouteVariants = routeLocales.length > 0;
const currentLocale = splitLocale(currentPath).locale;

const languageLinks = (hasRouteVariants ? routeLocales : locales).map((code) => ({
  code,
  label: getLocaleConfig(code).name,
  htmlLang: getLocaleConfig(code).htmlLang,
  href: hasRouteVariants ? localePath(currentPath, code) : guidesIndexPath(code),
}));

// A path gets a locale prefix ONLY where the build actually emitted one.
// localizedLocales() is the same gate the hreflang cluster above uses, so this
// can never advertise a URL that does not exist: /guides and /guides/faq ship
// in all seven locales, /glossary in en/pl/es/de, and /tools, /follow-pack,
// /about, /support, /settings, /privacy, /rss.xml, /humans.txt ship in English
// only. Those keep the English URL on purpose. A hand-built /pl/tools would
// read nicer and 404.
const localizedHref = (path: string) =>
  localizedLocales(path).includes(currentLocale) ? localePath(path, currentLocale) : path;

const linkLabel = (link: { id: string; label?: string }) =>
  link.label ?? t(`footer.links.${link.id}`, currentLocale);

const linkHref = (link: { href: string; external?: boolean }) =>
  link.external ? link.href : localizedHref(link.href);

const externalAria = (label: string) =>
  t('footer.externalLinkAria', currentLocale).replace('{label}', label);
---

<footer class="border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 transition-colors duration-200" role="contentinfo">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-8">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a
          href="/"
          class="flex items-center gap-2 mb-4"
          aria-label={t('footer.homeAria', currentLocale).replace('{site}', siteConfig.name)}
        >
          <div class="w-10 h-10 flex-shrink-0">
            <img class="scale-[1.5]" src="/logo-header.png" width={40} height={40} alt="" />
          </div>
          <LogoText client:idle size="sm" />
        </a>
        <p class="text-body-sm text-gray-600 dark:text-gray-400 mb-4 max-w-measure-narrow">
          {t('footer.tagline', currentLocale)}
        </p>
        <p class="text-caption text-gray-500 dark:text-gray-500 mb-6 max-w-measure-narrow">
          {t('footer.privacyNote', currentLocale)}
        </p>
        
        <!-- Social Share -->
        <div class="mb-4">
          <SocialShare />
        </div>
      </div>

      <!-- Learn -->
      <div>
        <h3 class="text-h4 font-semibold text-gray-900 dark:text-white mb-4">
          {t('footer.sections.learn', currentLocale)}
        </h3>
        <ul class="space-y-2" role="list">
          {footerLinks.learn.map((link) => (
            <li>
              <a
                href={linkHref(link)}
                class="text-body-sm text-gray-600 dark:text-gray-400 hover:text-primary-text dark:hover:text-primary-400 transition-colors underline-offset-2 hover:underline"
              >
                {linkLabel(link)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Tools -->
      <div>
        <h3 class="text-h4 font-semibold text-gray-900 dark:text-white mb-4">
          {t('footer.sections.tools', currentLocale)}
        </h3>
        <ul class="space-y-2" role="list">
          {toolLinks.map((link) => (
            <li>
              <a
                href={linkHref(link)}
                class="text-body-sm text-gray-600 dark:text-gray-400 hover:text-primary-text dark:hover:text-primary-400 transition-colors underline-offset-2 hover:underline"
              >
                {linkLabel(link)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Community & About -->
      <div>
        <h3 class="text-h4 font-semibold text-gray-900 dark:text-white mb-4">
          {t('footer.sections.community', currentLocale)}
        </h3>
        <ul class="space-y-2 mb-6" role="list">
          {footerLinks.community.map((link) => (
            <li>
              <a
                href={linkHref(link)}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                class="text-body-sm text-gray-600 dark:text-gray-400 hover:text-primary-text dark:hover:text-primary-400 transition-colors inline-flex items-center gap-1.5 underline-offset-2 hover:underline"
                aria-label={link.external ? externalAria(linkLabel(link)) : undefined}
              >
                {linkLabel(link)}
                {link.external && (
                  <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>

        <h3 class="text-h4 font-semibold text-gray-900 dark:text-white mb-4">
          {t('footer.sections.about', currentLocale)}
        </h3>
        <ul class="space-y-2" role="list">
          {footerLinks.about.map((link) => (
            <li>
              <a
                href={linkHref(link)}
                class="text-body-sm text-gray-600 dark:text-gray-400 hover:text-primary-text dark:hover:text-primary-400 transition-colors underline-offset-2 hover:underline"
              >
                {linkLabel(link)}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Languages -->
    <nav
      class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-800"
      aria-labelledby="footer-languages"
    >
      <h3 id="footer-languages" class="text-h4 font-semibold text-gray-900 dark:text-white mb-4">
        {t(hasRouteVariants ? 'footer.languages.thisPage' : 'footer.languages.guides', currentLocale)}
      </h3>
      <ul class="flex flex-wrap gap-x-5 gap-y-2" role="list">
        {languageLinks.map((link) => (
          <li>
            <a
              href={link.href}
              hreflang={link.htmlLang}
              lang={link.htmlLang}
              aria-current={link.code === currentLocale ? 'true' : undefined}
              class:list={[
                'text-body-sm transition-colors underline-offset-2 hover:underline hover:text-primary-text dark:hover:text-primary-400',
                link.code === currentLocale
                  ? 'text-primary-text dark:text-primary-400 font-medium'
                  : 'text-gray-600 dark:text-gray-400',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Bottom bar -->
    <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-caption text-gray-500 dark:text-gray-500">
        {t('footer.copyright', currentLocale)
          .replace('{year}', String(currentYear))
          .replace('{site}', siteConfig.name)}
      </p>
      <div class="flex items-center gap-4">
          <a 
          href="https://github.com/ptrio42/nostrich-love"
          target="_blank" 
          rel="noopener noreferrer"
          class="text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 transition-colors"
          aria-label={externalAria('GitHub')}
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
        </a>

      </div>
    </div>
  </div>
</footer>
