---
import { DarkModeToggleSimple } from '../ui/DarkModeToggle';
import { LanguageSwitcher } from '../LanguageSwitcher';
import { LogoText } from '../ui/LogoText';
import { GuidesLink } from '../navigation/GuidesLink';
import { siteConfig } from '../../config/site';
import { localizedLocales, localePath, splitLocale } from '../../i18n/paths';
// Locale passed explicitly to t(), same as Footer.astro: the header renders
// inside Layout's slot, and this is too visible to rest on render ordering.
import { t } from '../../i18n';

const currentLocale = splitLocale(Astro.url.pathname).locale;

// Both halves of every nav entry used to be literals, so a Polish reader got an
// English word pointing at an English page — on all 105 localized URLs.
//
// A path gets a locale prefix ONLY where the build actually emitted one.
// localizedLocales() is the same source of truth SEO.astro uses for hreflang:
// The homepage and /guides… ship in all seven locales, /glossary in en/pl/es/de, everything
// else in English only. Anything it does not list keeps the English URL, which
// is a language mismatch but a page that exists — inventing /pl/tools here
// would add to the 106 not-found URLs Google already has for this domain.
const localized = (path: string) =>
  localizedLocales(path).includes(currentLocale) ? localePath(path, currentLocale) : path;

const navLabel = (id: string) => t(`header.nav.${id}`, currentLocale);

const navItems = [
  { label: navLabel('tools'), href: localized('/tools/') },
  { label: navLabel('glossary'), href: localized('/glossary/') },
  { label: navLabel('resources'), href: localized('/resources/') },
  { label: navLabel('about'), href: localized('/about/') },
];

// NOTE: "Client Recommender" was removed here — it pointed at /tools#client-recommender,
// an anchor that has never existed on /tools (the ClientRecommender component is not
// rendered anywhere; see docs/audit-2026-07/market-research.md §2.3). Restore it only
// together with a page that actually hosts the component.
const toolItems = [
  { label: t('header.tools.keyGenerator', currentLocale), href: localized('/tools/key-generator/') },
  { label: t('header.tools.nip05Checker', currentLocale), href: localized('/tools/nip05-checker/') },
  { label: t('header.tools.twitterBridge', currentLocale), href: localized('/twitter-bridge/') },
];

const progressHref = localized('/progress/');
const settingsHref = localized('/settings/');
const homeAria = t('header.aria.home', currentLocale).replace('{site}', siteConfig.name);
---

<header class="sticky top-0 z-50 w-full border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 transition-colors duration-200" role="banner">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <a href={localePath('/', currentLocale)} class="flex items-center gap-3" aria-label={homeAria}>
        <div class="w-10 h-10 flex-shrink-0">
          <img class="scale-[1.5]" src="/logo-header.png" width={40} height={40} alt="" />
        </div>
        <LogoText size="sm" className="hidden sm:block" />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1" role="navigation" aria-label={t('header.aria.mainNav', currentLocale)}>
        <GuidesLink client:idle className="px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-primary-text dark:hover:text-primary-400 transition-colors rounded-md hover:bg-gray-100 dark:hover:bg-gray-800">{navLabel('guides')}</GuidesLink>
        {navItems.map((item) => (
          <a
            href={item.href}
            class="px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-primary-text dark:hover:text-primary-400 transition-colors rounded-md hover:bg-gray-100 dark:hover:bg-gray-800"
          >
            {item.label}
          </a>
        ))}
        
      </nav>

      <!-- Right side actions -->
      <div class="flex items-center gap-1">
        <LanguageSwitcher client:idle currentPath={Astro.url.pathname} />
        <DarkModeToggleSimple client:idle />
        
        <!-- User Menu with Progress/Badges -->
        <div class="relative group ms-2" id="user-menu">
          <button
            type="button"
            class="p-2 rounded-md text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
            id="user-menu-button"
            aria-label={t('header.aria.userMenu', currentLocale)}
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="user-menu-dropdown"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </button>
          <div id="user-menu-dropdown" class="absolute top-full end-0 mt-1 w-48 bg-white dark:bg-gray-800 rounded-lg shadow-raised border border-gray-200 dark:border-gray-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible group-[.is-open]:opacity-100 group-[.is-open]:visible group-[.is-closed]:!opacity-0 group-[.is-closed]:!invisible transition-opacity duration-150 z-50">
            <a
              href={progressHref}
              class="block px-4 py-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-text dark:hover:text-primary-400 hover:bg-gray-50 dark:hover:bg-gray-700 first:rounded-t-lg transition-colors"
            >
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
                {t('header.menu.progress', currentLocale)}
              </span>
            </a>
            <!-- Badges link - TEMPORARILY HIDDEN
            <a
              href="/badges"
              class="block px-4 py-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-text dark:hover:text-primary-400 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
            >
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                </svg>
                Badges
              </span>
            </a>
            -->
            <div class="border-t border-gray-200 dark:border-gray-700 my-1"></div>
            <a
              href={settingsHref}
              class="block px-4 py-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-text dark:hover:text-primary-400 hover:bg-gray-50 dark:hover:bg-gray-700 last:rounded-b-lg transition-colors"
            >
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                {t('header.menu.settings', currentLocale)}
              </span>
            </a>
          </div>
        </div>
        
        <!-- Mobile menu button -->
        <button
          type="button"
          class="md:hidden p-2 rounded-md text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
          aria-label={t('header.aria.toggleMenu', currentLocale)}
          aria-expanded="false"
          aria-controls="mobile-menu"
          id="mobile-menu-button"
        >
          <svg class="w-6 h-6 menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-6 h-6 close-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <nav
      class="md:hidden hidden border-t border-gray-200 dark:border-gray-800 py-4"
      id="mobile-menu"
      role="navigation"
      aria-label={t('header.aria.mobileNav', currentLocale)}
    >
      <div class="flex flex-col gap-2">
        <GuidesLink client:idle className="px-4 py-3 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-primary-text dark:hover:text-primary-400 transition-colors rounded-md hover:bg-gray-100 dark:hover:bg-gray-800">{navLabel('guides')}</GuidesLink>
        {navItems.map((item) => (
          <a
            href={item.href}
            class="px-4 py-3 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-primary-text dark:hover:text-primary-400 transition-colors rounded-md hover:bg-gray-100 dark:hover:bg-gray-800"
          >
            {item.label}
          </a>
        ))}
        
        <!-- Tools Section -->
        <div class="border-t border-gray-200 dark:border-gray-700 my-2 pt-2">
          <p class="px-4 py-2 text-micro font-semibold uppercase text-gray-500 dark:text-gray-400">{navLabel('tools')}</p>
          {toolItems.map((item) => (
            <a
              href={item.href}
              class="px-4 py-3 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-primary-text dark:hover:text-primary-400 transition-colors rounded-md hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center gap-2"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-gray-300 dark:bg-gray-600" aria-hidden="true"></span>
              {item.label}
            </a>
          ))}
        </div>
        
        <!-- User Menu Items -->
        <div class="border-t border-gray-200 dark:border-gray-700 my-2 pt-2">
          <p class="px-4 py-2 text-micro font-semibold uppercase text-gray-500 dark:text-gray-400">{t('header.menu.yourProgress', currentLocale)}</p>
          <a
            href={progressHref}
            class="px-4 py-3 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-primary-text dark:hover:text-primary-400 transition-colors rounded-md hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            {t('header.menu.viewProgress', currentLocale)}
          </a>
          <!-- View Badges link - TEMPORARILY HIDDEN
          <a
            href="/badges"
            class="px-4 py-3 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-primary-text dark:hover:text-primary-400 transition-colors rounded-md hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
            View Badges
          </a>
          -->
          <a
            href={settingsHref}
            class="px-4 py-3 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-primary-text dark:hover:text-primary-400 transition-colors rounded-md hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            {t('header.menu.settings', currentLocale)}
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = mobileMenuButton?.querySelector('.menu-icon');
  const closeIcon = mobileMenuButton?.querySelector('.close-icon');
  
  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
    const isOpen = !mobileMenu?.classList.contains('hidden');
    mobileMenuButton?.setAttribute('aria-expanded', String(isOpen));
  });
  
  // Close menu when clicking on a link
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
    });
  });
  
  // Close menu when pressing Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !mobileMenu?.classList.contains('hidden')) {
      mobileMenu?.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
      mobileMenuButton?.focus();
    }
  });

  // Desktop user menu: hover reveal stays CSS-only; this adds keyboard
  // (focus-within), click/touch toggle, Escape, and aria-expanded sync.
  // `.is-open` forces the dropdown visible (click toggle); `.is-closed`
  // forces it hidden so Escape can dismiss it while focus stays on the
  // trigger (otherwise group-focus-within would re-reveal it).
  const userMenu = document.getElementById('user-menu');
  const userMenuButton = document.getElementById('user-menu-button');

  if (userMenu && userMenuButton) {
    const setExpanded = (expanded: boolean) => {
      userMenuButton.setAttribute('aria-expanded', String(expanded));
    };

    const openUserMenu = () => {
      userMenu.classList.remove('is-closed');
      userMenu.classList.add('is-open');
      setExpanded(true);
    };

    const closeUserMenu = (suppressFocusReveal = false) => {
      userMenu.classList.remove('is-open');
      if (suppressFocusReveal) {
        userMenu.classList.add('is-closed');
      }
      setExpanded(false);
    };

    userMenuButton.addEventListener('click', () => {
      if (userMenu.classList.contains('is-open')) {
        closeUserMenu(true);
      } else {
        openUserMenu();
      }
    });

    // Keyboard reveal is CSS (group-focus-within); keep aria-expanded honest.
    userMenu.addEventListener('focusin', () => {
      if (!userMenu.classList.contains('is-closed')) {
        setExpanded(true);
      }
    });
    userMenu.addEventListener('focusout', (e) => {
      const next = e.relatedTarget;
      if (!(next instanceof Node) || !userMenu.contains(next)) {
        userMenu.classList.remove('is-closed');
        closeUserMenu();
      }
    });

    // Hover reveal is CSS; mirror the state for assistive tech.
    userMenu.addEventListener('mouseenter', () => {
      if (!userMenu.classList.contains('is-closed')) {
        setExpanded(true);
      }
    });
    userMenu.addEventListener('mouseleave', () => {
      userMenu.classList.remove('is-closed');
      if (!userMenu.classList.contains('is-open')) {
        setExpanded(false);
      }
    });

    // Escape closes the menu and returns focus to the trigger.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const active = document.activeElement;
      const withinMenu = active instanceof Node && userMenu.contains(active);
      if (userMenu.classList.contains('is-open') || withinMenu) {
        closeUserMenu(true);
        userMenuButton.focus();
      }
    });

    // Click outside closes a click-opened menu.
    document.addEventListener('click', (e) => {
      if (
        userMenu.classList.contains('is-open') &&
        e.target instanceof Node &&
        !userMenu.contains(e.target)
      ) {
        closeUserMenu();
      }
    });
  }
</script>
