---
import { siteConfig } from '../config/site';
import type { SEOProps } from '../config/seo-types';
import { type Locale, getLocaleConfig } from '../config/locales';
import { localePath, localizedLocales, DEFAULT_LOCALE } from '../i18n/paths';

interface Props extends SEOProps {
  locale?: Locale;
}

const {
  title,
  description,
  image,
  type = 'website',
  locale = 'en',
  publishedTime,
  modifiedTime,
  author,
  tags,
  noindex = false,
  nofollow = false,
  canonical,
  jsonLd,
} = Astro.props;

// Format title with template
const formattedTitle = title 
  ? siteConfig.seo.titleTemplate.replace('%s', title)
  : siteConfig.seo.defaultTitle;

const metaDescription = description || siteConfig.seo.defaultDescription;
const ogImage = new URL(image || siteConfig.seo.defaultImage, siteConfig.url).toString();
// Dimensions are only known for the shared default card. A page passing its own
// `image` gets no width/height rather than the wrong ones — a scraper handles a
// missing hint fine, but a wrong one makes it lay out the card incorrectly.
const ogImageSize = image
  ? null
  : { width: siteConfig.seo.defaultImageWidth, height: siteConfig.seo.defaultImageHeight };
const canonicalURL = canonical || new URL(Astro.url.pathname, siteConfig.url).toString();

// Get locale configuration
const localeConfig = getLocaleConfig(locale);

// Build alternate URLs for hreflang.
// Only emit them for locales the route is genuinely built in — otherwise we
// advertise 404s as alternates and search engines drop the whole cluster.
// localizedLocales() returns the exact per-route set (guides: all seven,
// glossary: en/pl/es/de, everything else: none).
const currentPath = Astro.url.pathname;
const routeLocales = localizedLocales(currentPath);

const alternateUrls = routeLocales.map((l) => ({
  locale: l,
  hreflang: getLocaleConfig(l).htmlLang,
  url: new URL(localePath(currentPath, l), siteConfig.url).toString(),
}));

// x-default points at the un-prefixed English version
const xDefaultUrl = routeLocales.length > 0
  ? new URL(localePath(currentPath, DEFAULT_LOCALE), siteConfig.url).toString()
  : null;
---

<!-- Primary Meta Tags -->
<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={metaDescription} />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content={`${noindex ? 'noindex' : 'index'}, ${nofollow ? 'nofollow' : 'follow'}`} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Hreflang tags for international SEO (per-route locale set — see localizedLocales) -->
{alternateUrls.map(({ hreflang, url }) => (
  <link rel="alternate" hreflang={hreflang} href={url} />
))}
{xDefaultUrl && <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />}

<!-- Language -->
<meta name="language" content={localeConfig.htmlLang} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:image" content={ogImage} />
{ogImageSize && <meta property="og:image:width" content={String(ogImageSize.width)} />}
{ogImageSize && <meta property="og:image:height" content={String(ogImageSize.height)} />}
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={localeConfig.ogLocale} />

<!-- Open Graph Article (if applicable) -->
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
{type === 'article' && author && (
  <meta property="article:author" content={author} />
)}
{type === 'article' && tags && tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Structured data -->
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@nostrichlove" />
<meta name="twitter:creator" content="@nostrichlove" />
<meta name="twitter:title" content={formattedTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImage} />

<!-- Favicon -->
<link rel="icon" type="image/x-icon" href="/brand/illustrated/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/brand/illustrated/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/brand/illustrated/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/brand/illustrated/favicon-16x16.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Theme Color -->
<meta name="theme-color" content="#8B5CF6" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0F0A1A" media="(prefers-color-scheme: dark)" />

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Humans.txt -->
<link rel="author" href="/humans.txt" />
