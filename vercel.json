{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(preview_image.png|logo.png|logo-header.png|apple-touch-icon.png|android-chrome-:size.png|favicon-:size.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^www\\.nostrich\\.love$"
        }
      ],
      "destination": "https://nostrich.love/:path*",
      "permanent": true
    },
    {
      "source": "/:oldLocale([a-z][a-z])/:locale([a-z][a-z])/guides",
      "destination": "/:locale/guides/",
      "permanent": true
    },
    {
      "source": "/:oldLocale([a-z][a-z])/:locale([a-z][a-z])/guides/",
      "destination": "/:locale/guides/",
      "permanent": true
    },
    {
      "source": "/:oldLocale([a-z][a-z])/:locale([a-z][a-z])/guides/:slug",
      "destination": "/:locale/guides/:slug/",
      "permanent": true
    },
    {
      "source": "/:oldLocale([a-z][a-z])/:locale([a-z][a-z])/guides/:slug/",
      "destination": "/:locale/guides/:slug/",
      "permanent": true
    },
    {
      "source": "/en/guides",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/en/guides/",
      "destination": "/guides/",
      "permanent": true
    },
    {
      "source": "/en/guides/:slug",
      "destination": "/guides/:slug",
      "permanent": true
    },
    {
      "source": "/en/guides/:slug/",
      "destination": "/guides/:slug/",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/simulators",
      "destination": "https://sandstr.app",
      "permanent": true
    },
    {
      "source": "/simulators/",
      "destination": "https://sandstr.app",
      "permanent": true
    },
    {
      "source": "/simulators/:slug*",
      "destination": "https://sandstr.app",
      "permanent": true
    },
    {
      "source": "/simulators/:slug*/",
      "destination": "https://sandstr.app",
      "permanent": true
    },
    {
      "source": "/damus-demo",
      "destination": "https://sandstr.app",
      "permanent": true
    },
    {
      "source": "/damus-demo/",
      "destination": "https://sandstr.app",
      "permanent": true
    },
    {
      "source": "/nostr-for-:slug",
      "destination": "/follow-pack",
      "permanent": true
    },
    {
      "source": "/nostr-for-:slug/",
      "destination": "/follow-pack/",
      "permanent": true
    }
  ]
}
